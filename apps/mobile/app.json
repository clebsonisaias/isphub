{
  "expo": {
    "name": "ISPhub Técnico",
    "slug": "isphub-tecnico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isphub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clebsonisaias.isphubtecnico"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite gravar áudios pra enviar no chat interno."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher fotos da galeria pra enviar no chat interno.",
          "cameraPermission": "Permite tirar fotos pra enviar no chat interno."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite compartilhar sua localização atual no chat interno."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
