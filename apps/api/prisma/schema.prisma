// ISPhub — schema do banco espelho.
// Toda entidade operacional carrega provedorId: e o que sustenta a fila
// unificada (todos os provedores) e, ao mesmo tempo, o destaque/filtro por
// provedor (badge com cor + logo) na UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  gestor
  tecnico
  provedor
}

enum ErpTipo {
  SGP
}

enum OsStatus {
  aberta
  em_deslocamento
  em_execucao
  concluida
  cancelada
  pendente
}

/// Tipo de evento na timeline de uma OS.
enum OsEventoTipo {
  atribuicao
  status
  anotacao
  foto
  edicao
}

model Provedor {
  id       String   @id @default(uuid())
  nome     String
  cor      String   @default("#6366f1")
  logoUrl  String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  erpConfigs    ErpConfig[]
  tiposOs       TipoOs[]
  ordensServico OrdemServico[]
  usuarios      Usuario[]
  syncLogs      SyncLog[]
  /// Lancamentos em que este provedor e a CONTRAPARTE (quem deve a hub).
  /// Diferente de todas as relacoes acima: nao e particao multi-tenant.
  lancamentos   Lancamento[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]

  @@map("provedores")
}

/// Credenciais de acesso ao ERP de um provedor. O token e armazenado
/// criptografado (AES-256-GCM) — ver src/lib/crypto.ts — nunca em claro.
model ErpConfig {
  id                       String    @id @default(uuid())
  provedorId               String
  provedor                 Provedor  @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  tipo                     ErpTipo   @default(SGP)
  url                      String
  app                      String
  /// Token criptografado (iv:authTag:ciphertext em base64).
  tokenCifrado             String
  intervaloPollingSegundos Int       @default(60)
  ativo                    Boolean   @default(true)
  ultimaSyncEm             DateTime?
  ultimaSyncOk             Boolean?
  ultimaSyncMensagem       String?
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt

  @@unique([provedorId, tipo])
  @@map("erp_configs")
}

/// Categoria canonica da ISPhub (global, nao por provedor) — taxonomia unica
/// pra unificar os "motivos"/tipos de OS de cada SGP, que cada provedor nomeia
/// diferente (ex.: "Instalacao" x "Novo cliente" x "Ativacao" sao a mesma
/// categoria em provedores distintos). Ver [[categoriaMatch.ts]] para o
/// auto-mapeamento por palavra-chave.
model Categoria {
  id             String   @id @default(uuid())
  nome           String   @unique
  cor            String   @default("#6366f1")
  /// Nome de icone lucide (ex.: "wrench", "wifi-off"). Opcional.
  icone          String?
  /// Palavras-chave (normalizadas: minusculas, sem acento/emoji) usadas pelo
  /// auto-mapeamento pra sugerir esta categoria a partir da descricao do tipo.
  palavrasChave  String[] @default([])
  /// SLA herdado por tipos mapeados sem SLA proprio definido.
  slaHorasPadrao Int?
  /// Marca categorias cujas OS sao executadas por equipe de FORA (do proprio
  /// provedor), nao pela equipe da ISPhub — ex.: retirada/cancelamento de
  /// equipamento. Elas saem da fila/mapa/alertas de SLA da operacao e ganham
  /// tela propria (ver equipeService.ts). Fica na categoria (nao no nome do
  /// tipo) porque cada SGP nomeia o tipo do seu jeito e o admin ja mantem
  /// essa taxonomia em Categoria, nao em TipoOs.
  equipeExterna  Boolean  @default(false)
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())

  tiposOs TipoOs[]

  @@map("categorias")
}

/// Tipo de OS importado do catalogo do ERP e exibido no ISPhub.
model TipoOs {
  id          String     @id @default(uuid())
  provedorId  String
  provedor    Provedor   @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  sgpCodigo   String
  descricao   String
  /// null = "Nao classificado" (aguardando mapeamento manual ou auto-match).
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  visivel     Boolean    @default(true)
  /// Prazo de SLA em horas; null = sem SLA proprio (usa o padrao da categoria).
  slaHoras    Int?

  ordensServico OrdemServico[]

  @@unique([provedorId, sgpCodigo])
  @@map("tipos_os")
}

/// Ordem de Servico espelhada do ERP do provedor.
model OrdemServico {
  id                   String    @id @default(uuid())
  provedorId           String
  provedor             Provedor  @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  sgpOsId              String
  tipoOsId             String?
  tipoOs               TipoOs?   @relation(fields: [tipoOsId], references: [id], onDelete: SetNull)
  status               OsStatus  @default(aberta)
  prioridade           Int       @default(2)
  clienteNome          String?
  clienteDocumento     String?
  /// Telefone/contato do cliente, do cadastro no SGP (/api/ura/clientes/) —
  /// a listagem de OS nao traz, vem no mesmo backfill do endereco/geo.
  telefone             String?
  contratoId           String?
  protocolo            String?
  conteudo             String?
  observacao           String?
  logradouro           String?
  numero               String?
  bairro               String?
  cidade               String?
  lat                  Float?
  lng                  Float?
  /// Localidade/POP do SGP (ex.: "Macaíba") — o SGP nao expoe endereco de
  /// rua nas listagens de OS, isso e o dado de localizacao mais
  /// fino disponivel.
  pop                  String?
  /// Status do contrato no SGP no momento do sync (ex.: "Ativo",
  /// "Cancelado"). Usado para alertar o gestor/tecnico antes de despachar
  /// para um contrato ja cancelado/suspenso.
  contratoStatus       String?
  /// Usuario do SGP que registrou a OS (auditoria).
  usuario              String?
  /// Data/hora reais de abertura no SGP (data_cadastro+hora_cadastro) —
  /// distinta de criadoEm, que so reflete quando o ISPhub sincronizou pela
  /// primeira vez.
  dataCadastro         DateTime?
  dataAgendamento      DateTime?
  /// Tecnico ISPhub atribuido (Usuario com role=tecnico) — despacho feito
  /// dentro do ISPhub, nao vem do SGP.
  tecnicoId            String?
  tecnico              Usuario?  @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  /// Nome do tecnico designado no SGP do provedor (informativo — o SGP e de
  /// pessoal do provedor, nao do tecnico ISPhub que de fato executa a OS).
  tecnicoSgpNome       String?
  /// Marca quando o alerta de "SLA estourado" ja foi disparado pra esta OS —
  /// evita notificar de novo a cada tick do slaAlertScheduler.
  slaNotificadoEm      DateTime?
  /// Quando o status foi alterado por acao humana no ISPhub (writebackService),
  /// nao pelo sync. Usado pra sync nao sobrescrever, por uma janela de graca,
  /// um status recem-confirmado com o SGP enquanto a leitura do SGP ainda
  /// nao refletiu a escrita (consistencia eventual do lado do SGP).
  statusAlteradoEm     DateTime?
  /// Quando a observacao (eco local da ultima anotacao) foi alterada por
  /// acao humana — mesma logica do statusAlteradoEm, mas pro campo
  /// observacao: o SGP nao expoe historico de anotacoes pra confirmar a
  /// escrita, entao o sync so volta a confiar na leitura dele apos a janela
  /// de graca (ver syncService.ts).
  observacaoAlteradaEm DateTime?
  /// Quando o backfill tentou puxar o cadastro do cliente (/api/ura/clientes/)
  /// pra esta OS — a listagem de OS do SGP nao traz endereco de rua, geo nem
  /// telefone, so esse endpoint traz. Marca a TENTATIVA (com ou sem dado) pra
  /// nao reconsultar pra sempre um contrato que o SGP nao detalha; reconsulta
  /// so apos um TTL (ver syncService.ts).
  geoConsultadoEm      DateTime?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  sincronizadoEm       DateTime  @default(now())

  atribuicoes  Atribuicao[]
  eventos      OsEvento[]
  notificacoes Notificacao[]
  /// Thread de chat da OS — no maximo 1 por OS (ver Conversa.ordemServicoId @unique).
  conversa     Conversa?

  @@unique([provedorId, sgpOsId])
  @@index([provedorId, status])
  @@index([status, dataAgendamento])
  @@index([tecnicoId])
  @@map("ordens_servico")
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  senhaHash         String
  role              UserRole
  /// Preenchido apenas para role=provedor (escopa o acesso a um unico provedor).
  provedorId        String?
  provedor          Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now())
  /// Versao da sessao. Vai dentro do JWT; `requireAuth` compara com o valor do
  /// banco e recusa o token se diferir. E o unico jeito de INVALIDAR um token
  /// ja emitido — sem isto, desativar o usuario, trocar a senha, rebaixar o
  /// papel ou mudar o provedorId nao derrubava nada: o token velho continuava
  /// valendo (com o papel ANTIGO) por ate 8h em todas as rotas.
  /// Incrementa em: desativacao, troca de papel, troca de provedor e troca de
  /// senha. Ver services/authService.ts e routes/usuarios.ts.
  tokenVersion      Int       @default(0)
  /// Presenca barata do chat: atualizado (com throttle de ~60s, ver
  /// middleware de presenca) a cada request autenticado. online = visto nos
  /// ultimos ~2min — nunca calculado no cliente.
  ultimaAtividadeEm DateTime?

  /// Foto de perfil (bytes-in-postgres, mesmo padrao do anexo de chat —
  /// Mensagem.anexoDados). Null = sem foto, cliente cai pro circulo de iniciais.
  fotoDados   Bytes?
  fotoMime    String?
  /// Denormalizado: evita selecionar fotoDados (bytes crus) em toda query de
  /// lista de contatos/mensagens so pra saber se a foto existe.
  temFoto     Boolean @default(false)
  /// Incrementado a cada upload/remocao de foto. Nunca exibido — vira `?v=`
  /// no path da foto (GET /auth/foto/:id?v=N) pra invalidar o cache local do
  /// app baseado-em-arquivo (ver baixarAnexoAutenticado em apps/mobile),
  /// que senao guardaria a foto antiga pra sempre pela mesma chave de path.
  fotoVersao  Int     @default(0)
  /// Status manual (um StatusPreset — ver packages/shared). Sibling do
  /// `online` computado acima: nunca substitui a presenca automatica.
  status      String?
  /// Complemento livre opcional ao status (ex.: "cliente X ate 15h").
  statusTexto String? @db.VarChar(140)

  /// Apelido editavel exibido no chat/UI — `nome` continua fixo (cadastro).
  nomeExibicao    String? @db.VarChar(80)
  bio             String? @db.VarChar(280)
  /// Telefone de contato — distinto das credenciais de login (email/senha).
  telefoneContato String? @db.VarChar(30)
  /// Assinatura opcional anexada as mensagens do chat interno deste usuario.
  assinaturaChat  String? @db.VarChar(140)
  /// Cor de destaque pessoal (hex "#rrggbb") — sibling de Provedor.cor, mas de
  /// uso pessoal (perfil), nao de identidade de marca/badge cross-cutting.
  corDestaque     String? @db.VarChar(7)

  ordensServico OrdemServico[]
  atribuicoes   Atribuicao[]
  eventos       OsEvento[]
  notificacoes  Notificacao[]

  conversasCriadas  Conversa[]             @relation("ConversasCriadas")
  participacoesChat ConversaParticipante[]
  mensagens         Mensagem[]             @relation("MensagensDoAutor")
  mensagemReacoes   MensagemReacao[]

  conversasClienteAtendidas ConversaCliente[] @relation("ConversaClienteAgente")
  conversasClienteIniciadas ConversaCliente[] @relation("ConversaClienteIniciadaPor")
  mensagensClienteEnviadas  MensagemCliente[] @relation("MensagemClienteAutor")

  pushTokens PushToken[]

  sessoesRefresh    SessaoRefresh[]
  tokensRecuperacao TokenRecuperacaoSenha[]

  lancamentosCriados Lancamento[]       @relation("LancamentosCriados")
  recorrenciasCriadas Recorrencia[]     @relation("RecorrenciasCriadas")
  parcelamentosCriados Parcelamento[]   @relation("ParcelamentosCriados")
  lancamentoEventos  LancamentoEvento[] @relation("LancamentoEventos")

  @@map("usuarios")
}

/// Sessao longa do navegador (refresh token rotativo).
///
/// O access token (JWT, 8h) continua sendo a credencial de toda chamada; este
/// model e o que permite RENOVA-LO sem pedir a senha de novo. Separar os dois e
/// o que torna possivel "sessao que dura enquanto a pessoa usa" sem deixar um
/// token de 30 dias circulando em cada request.
///
/// O token cru NUNCA e gravado — so o SHA-256 dele. Um dump do banco nao
/// entrega sessao de ninguem, mesma logica de `senhaHash`.
model SessaoRefresh {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) do token cru. Unico: e por ele que a validacao busca.
  tokenHash  String    @unique
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  /// Ultima vez que este refresh foi trocado por um novo — e o que define
  /// "inatividade": ninguem renova, ninguem usa, a sessao morre em `expiraEm`.
  usadoEm    DateTime?
  /// Marca a rotacao. Tambem e o relogio da JANELA DE GRACA: um refresh
  /// apresentado logo apos ser queimado e a outra aba do mesmo usuario, nao
  /// um token roubado (ver refreshService.ts).
  revogadoEm DateTime?

  /// Contexto so pra exibir "de onde" numa futura tela de sessoes ativas.
  userAgent String? @db.VarChar(300)
  ip        String? @db.VarChar(64)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes_refresh")
}

/// Servidor de e-mail do ISPhub, editavel pelo admin.
///
/// Existia so como variavel de ambiente, o que obrigava um redeploy (e acesso
/// ao Coolify) pra trocar uma senha de SMTP. Mesmo desenho do
/// [[CanalWhatsappConfig]]: blob unico cifrado, `ativo`, e o resultado da
/// ultima verificacao — a senha nunca toca o disco em claro.
model SmtpConfig {
  id                        String    @id @default(uuid())
  /// Singleton: sempre "global". Existe pra dar um alvo estavel ao upsert.
  /// O SMTP e do ISPhub (quem manda o e-mail de recuperacao), nao de cada
  /// provedor — por isso um registro so, e nao um por provedorId.
  escopo                    String    @unique @default("global")
  /// JSON {host,port,secure,usuario,senha,remetente} cifrado como UM blob
  /// via encrypt() — mesmo formato de ErpConfig.tokenCifrado.
  configCifrado             String
  ativo                     Boolean   @default(true)
  /// Preenchidos pelo "enviar e-mail de teste": e a unica forma de saber que
  /// a configuracao funciona ANTES de alguem depender dela pra recuperar senha.
  ultimaVerificacaoEm       DateTime?
  ultimaVerificacaoOk       Boolean?
  ultimaVerificacaoMensagem String?
  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  @@map("smtp_config")
}

/// Token de uso unico pra redefinir senha sem estar logado.
///
/// Mesma regra do refresh: grava so o SHA-256. Quem tem acesso ao banco nao
/// consegue forjar o link que chega no e-mail.
model TokenRecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  /// Preenchido no primeiro uso — e o que impede reuso do mesmo link.
  usadoEm   DateTime?

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("tokens_recuperacao_senha")
}

enum PushPlataforma {
  android
  ios
}

/// Aparelho registrado para receber push (Expo Push Service).
///
/// A chave unica e o TOKEN, nao (usuario, token): o token identifica o
/// APARELHO. Se outro tecnico logar no mesmo celular, o registro tem que
/// migrar de dono — se fosse unico por par, o aparelho ficaria com dois donos e
/// o tecnico anterior continuaria recebendo as mensagens do novo (vazamento de
/// conversa entre pessoas que dividem aparelho, coisa comum em equipe de campo).
model PushToken {
  id         String         @id @default(uuid())
  /// Token do Expo (`ExponentPushToken[...]`).
  token      String         @unique
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plataforma PushPlataforma
  criadoEm   DateTime       @default(now())
  /// Toda vez que o app registra de novo — serve pra expirar aparelho parado.
  vistoEm    DateTime       @updatedAt

  @@index([usuarioId])
  @@map("push_tokens")
}

/// Despacho de uma OS para um tecnico (historico de atribuicoes).
model Atribuicao {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tecnicoId      String
  tecnico        Usuario      @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  atribuidoEm    DateTime     @default(now())
  atribuidoPor   String?

  @@index([ordemServicoId])
  @@index([tecnicoId])
  @@map("atribuicoes")
}

/// Timeline de uma OS: toda acao feita dentro do ISPhub (status, anotacao,
/// atribuicao, foto) vira um evento aqui. So nasce de acao humana — a criacao
/// da OS via sync nao gera evento. Fotos (tipo=foto) sao hospedadas no
/// proprio SGP (ver connectors/sgp.ts addOsImage/listOsImages) — o evento so
/// guarda a descricao, sem FK local pra nenhum arquivo.
model OsEvento {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipo           OsEventoTipo
  autorId        String?
  autor          Usuario?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  descricao      String
  criadoEm       DateTime     @default(now())

  @@index([ordemServicoId, criadoEm])
  @@map("os_eventos")
}

/// Notificacao in-app pra um usuario (atribuicao de OS, SLA estourado).
model Notificacao {
  id             String        @id @default(uuid())
  usuarioId      String
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo           String
  mensagem       String
  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  lida           Boolean       @default(false)
  criadoEm       DateTime      @default(now())

  @@index([usuarioId, lida, criadoEm])
  @@map("notificacoes")
}

/// Estado EDITAVEL de um modulo do app do tecnico (Fase 2). Os metadados
/// imutaveis (nome, icone, se e core) vivem no codigo (shared: MODULO_CATALOGO);
/// aqui fica so o que o admin muda. `moduloId` e um dos MODULO_IDS (uniao
/// fechada, validada na aplicacao). Ausencia de registro = usa o padrao do
/// catalogo. Nao ha coluna `core` de proposito: core=false fica irrepresentavel.
model ModuloConfig {
  id              String   @id @default(uuid())
  moduloId        String   @unique
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  rolesPermitidos String[]
  atualizadoEm    DateTime @updatedAt

  @@map("modulo_configs")
}

/// Auditoria de cada ciclo de sync (pull) e write-back (push) por provedor.
model SyncLog {
  id         String   @id @default(uuid())
  provedorId String
  provedor   Provedor @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  direcao    String // "pull" | "push"
  recurso    String // "os" | "tipos" | "tecnicos" | ...
  ok         Boolean
  mensagem   String?
  quantidade Int?
  iniciadoEm DateTime @default(now())
  duracaoMs  Int?

  @@index([provedorId, iniciadoEm])
  @@map("sync_logs")
}

// ---- Chat interno de operacao ----
// Coordenacao de campo ancorada no trabalho (thread por OS), auditavel (soft
// delete, nunca apaga de verdade), restrita a equipe interna — PROVEDOR nunca
// participa (a guarda de verdade e no servidor: chatService.podeParticipar).

enum ConversaTipo {
  direta
  grupo
  os
  avisos
}

enum MensagemTipo {
  texto
  foto
  audio
  localizacao
  os_ref
  sistema
}

model Conversa {
  id               String        @id @default(uuid())
  tipo             ConversaTipo
  /// Titulo explicito (grupo/avisos) — DM e thread de OS derivam o titulo no
  /// servidor (nome do outro participante / "OS #sgpOsId"), nao fica salvo aqui.
  titulo           String?
  /// Thread de OS: no maximo 1 conversa por OS (idempotencia de
  /// garantirConversaDeOs vem desse @unique).
  ordemServicoId   String?       @unique
  ordemServico     OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  criadoPorId      String?
  criadoPor        Usuario?      @relation("ConversasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)
  /// Denormalizado: ordena a lista de conversas sem varrer mensagens (evita N+1).
  ultimaMensagemEm DateTime?
  arquivada        Boolean       @default(false)
  criadoEm         DateTime      @default(now())

  participantes ConversaParticipante[]
  mensagens     Mensagem[]

  @@index([tipo, ultimaMensagemEm])
  @@map("conversas")
}

model ConversaParticipante {
  id              String    @id @default(uuid())
  conversaId      String
  conversa        Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Pode renomear/adicionar/remover participante (grupo). Sem efeito em DM/OS/avisos.
  admin           Boolean   @default(false)
  /// Marca d'agua de leitura: nao-lidas = mensagens com criadoEm > este valor.
  /// Evita uma linha de "lido" por mensagem, que explodiria em volume.
  ultimaLeituraEm DateTime?
  silenciado      Boolean   @default(false)
  /// Saiu do grupo (soft — preserva o historico de quem participou quando).
  saiuEm          DateTime?

  @@unique([conversaId, usuarioId])
  @@index([usuarioId, conversaId])
  @@map("conversa_participantes")
}

model Mensagem {
  id             String       @id @default(uuid())
  conversaId     String
  conversa       Conversa     @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  /// null = mensagem do sistema ("Fulano assumiu a OS"), sem autor humano.
  autorId        String?
  autor          Usuario?     @relation("MensagensDoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  tipo           MensagemTipo
  /// Texto, legenda da foto, ou rotulo do sistema.
  corpo          String?
  /// Midia local (chat NAO e evidencia de OS — nao espelha o SGP, entao nao
  /// segue o padrao de proxy-ao-vivo das fotos de evidencia). Limite validado
  /// no servidor: foto <=400KB, audio <=60s e <=500KB (ver chatService). Se o
  /// volume crescer, migrar pra S3/MinIO e trocar `anexoDados` por uma URL —
  /// o contrato de API (Mensagem.anexoMime/anexoTamanho) nao muda.
  anexoDados     Bytes?
  anexoMime      String?
  anexoTamanho   Int?
  /// Audio, em segundos.
  duracaoSeg     Int?
  lat            Float?
  lng            Float?
  /// Card de OS compartilhado no chat (tipo os_ref).
  ordemServicoId String?
  respondendoAId String?
  respondendoA   Mensagem?    @relation("Respostas", fields: [respondendoAId], references: [id], onDelete: SetNull)
  respostas      Mensagem[]   @relation("Respostas")
  editadoEm      DateTime?
  /// SOFT DELETE — contexto operacional e prova; nada some do banco. Quem
  /// apagou fica so como String (mesmo padrao de Atribuicao.atribuidoPor —
  /// auditoria informativa, sem FK).
  apagadoEm      DateTime?
  apagadoPorId   String?
  criadoEm       DateTime     @default(now())

  reacoes MensagemReacao[]

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

model MensagemReacao {
  id         String   @id @default(uuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  emoji      String
  criadoEm   DateTime @default(now())

  @@unique([mensagemId, usuarioId, emoji])
  @@map("mensagem_reacoes")
}

// ---- Chat com clientes (WhatsApp) ----
// Separado de propósito de Conversa/Mensagem/ConversaParticipante (chat
// interno) — um cliente de WhatsApp não tem Usuario/login, só telefone, e
// ConversaParticipante.usuarioId é FK obrigatória. Ver plano da feature.

enum CanalWhatsapp {
  meta
  evolution
}

enum MensagemClienteDirecao {
  entrada
  saida
}

enum MensagemClienteTipo {
  texto
  imagem
  audio
  documento
  localizacao
  sistema
}

/// Quem deu o primeiro passo. `entrada` = cliente mandou mensagem (nasce no
/// webhook, sem staff envolvido). `saida` = staff iniciou por template HSM.
/// Existe separado de `iniciadaPorId` porque este ultimo vira null quando o
/// usuario e deletado (onDelete: SetNull) — e ai a conversa continuaria
/// parecendo entrante, virando visivel na regra de escopo errada.
enum OrigemConversaCliente {
  entrada
  saida
}

/// Config global (nao por provedor) de cada integracao WhatsApp — mirror de
/// ErpConfig sem provedorId: ha so UMA conta Meta + UMA instancia Evolution
/// pro ISPhub inteiro (decisao explicita do usuario).
model CanalWhatsappConfig {
  id                        String        @id @default(uuid())
  tipo                      CanalWhatsapp @unique
  /// JSON do config inteiro (phoneNumberId/accessToken/verifyToken/appSecret
  /// pra meta; baseUrl/apiKey/instanceName pra evolution) cifrado como UM
  /// blob via encrypt() ja existente — mesmo formato de ErpConfig.tokenCifrado.
  configCifrado             String
  ativo                     Boolean       @default(true)
  ultimaVerificacaoEm       DateTime?
  ultimaVerificacaoOk       Boolean?
  ultimaVerificacaoMensagem String?
  criadoEm                  DateTime      @default(now())
  atualizadoEm              DateTime      @updatedAt

  @@map("canais_whatsapp_configs")
}

/// Conversa com um CLIENTE via WhatsApp — sem Usuario do lado do cliente.
model ConversaCliente {
  id               String                @id @default(uuid())
  /// E.164 sem prefixo, ex "5584999999999". Mesmo numero em canais diferentes
  /// e uma conversa DISTINTA por canal (cada canal e um numero/instancia diferente).
  telefone         String
  canal            CanalWhatsapp
  /// Nome de perfil do WhatsApp do cliente — informativo, nunca chave.
  nomeContato      String?
  /// Quem esta atendendo AGORA. Muda com assumir/transferir — nao serve como
  /// chave de visibilidade do tecnico (transferir tiraria a conversa dele).
  agenteId         String?
  agente           Usuario?              @relation("ConversaClienteAgente", fields: [agenteId], references: [id], onDelete: SetNull)
  /// Quem INICIOU a conversa por template. null = entrante (nasceu do webhook).
  /// E a chave de visibilidade do TECNICO: ele so enxerga o que ele mesmo
  /// iniciou. Setado APENAS no create do upsert — no update nao se toca, senao
  /// um segundo tecnico disparando pro mesmo numero roubaria a thread do
  /// primeiro (ha uma unica thread por telefone+canal, ver @@unique abaixo).
  iniciadaPorId    String?
  iniciadaPor      Usuario?              @relation("ConversaClienteIniciadaPor", fields: [iniciadaPorId], references: [id], onDelete: SetNull)
  origem           OrigemConversaCliente @default(entrada)
  arquivada        Boolean               @default(false)
  ultimaMensagemEm DateTime?
  criadoEm         DateTime              @default(now())

  mensagens MensagemCliente[]

  @@unique([telefone, canal])
  @@index([canal, arquivada, ultimaMensagemEm])
  @@index([agenteId])
  /// Escopo do tecnico filtra por este campo em toda listagem — sem indice a
  /// lista degrada junto com o volume de conversas.
  @@index([iniciadaPorId])
  @@map("conversas_clientes")
}

model MensagemCliente {
  id           String                 @id @default(uuid())
  conversaId   String
  conversa     ConversaCliente        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  /// Denormalizado de conversa.canal — so pro @@unique abaixo (webhooks
  /// WhatsApp reentregam o mesmo evento; isto torna a ingestao idempotente).
  canal        CanalWhatsapp
  direcao      MensagemClienteDirecao
  /// Staff que enviou (direcao=saida). Null em mensagens do cliente/sistema.
  autorId      String?
  autor        Usuario?               @relation("MensagemClienteAutor", fields: [autorId], references: [id], onDelete: SetNull)
  tipo         MensagemClienteTipo
  corpo        String?
  /// Midia recebida do WhatsApp — baixada e persistida (URLs da Meta expiram
  /// ~5min, nao da pra so referenciar). Teto de 5MB, ver LIMITE_MIDIA_CLIENTE_BYTES.
  anexoDados   Bytes?
  anexoMime    String?
  anexoTamanho Int?
  duracaoSeg   Int?
  lat          Float?
  lng          Float?
  /// Id da mensagem no provedor (wamid do Meta / id da Evolution).
  waMessageId  String
  /// Falha ao ENVIAR (direcao=saida) — erro do connector, exibido na bolha.
  falhaEnvio   String?
  /// Nome do template HSM disparado (so em mensagens que abriram conversa).
  /// `corpo` guarda o texto JA RENDERIZADO com as variaveis substituidas — o
  /// Maxxi grava so o marcador "[Template: nome]" e o atendente fica sem saber
  /// o que foi realmente enviado ao cliente.
  templateNome String?
  /// Variaveis efetivamente enviadas ({ "1": "Joao", "2": "10/08" }).
  templateVars Json?
  criadoEm     DateTime               @default(now())

  @@unique([canal, waMessageId])
  @@index([conversaId, criadoEm])
  @@map("mensagens_clientes")
}

// ---------------------------------------------------------------------------
// FINANCEIRO DA HUBISP
//
// Este bloco e o UNICO do schema que nao fala do assinante do provedor. Aqui o
// dinheiro e da propria HubISP: o que cada provedor paga a ela (contrato
// provedor<->hub) e o que ela mesma gasta. Titulo, fatura e boleto de cliente
// final do SGP NAO entram — o conector SGP nem e consultado por este modulo.
//
// Consequencia que vale gravar: `Lancamento.provedorId` e CONTRAPARTE ("quem
// deve a hub"), nao particao multi-tenant ("de quem e este dado"). Todo o resto
// do schema usa provedorId como fronteira de acesso; aqui e campo de negocio,
// opcional, e o acesso e controlado por papel (so ADMIN por padrao).
// ---------------------------------------------------------------------------

enum LancamentoTipo {
  receita
  despesa
}

/// So o que e FATO. "Atrasado" nao esta aqui de proposito: e funcao pura de
/// (vencimento < hoje && status = pendente), derivada na leitura. Grava-lo
/// exigiria um job virando linhas, e entre duas execucoes o banco mentiria.
enum LancamentoStatus {
  pendente
  pago
  cancelado
}

enum FormaPagamento {
  pix
  boleto
  transferencia
  dinheiro
  cartao
  outro
}

enum LancamentoEventoTipo {
  criado
  editado
  baixado
  estornado
  cancelado
}

/// Onde a despesa entra no DRE.
///
/// Vive na CATEGORIA, nao no lancamento — e a diferenca que decide se o
/// relatorio presta. No ERP de origem esse campo fica em cada transacao, e a
/// propria documentacao deles registra o resultado: "despesas sem
/// classificacao caem silenciosamente em custos variaveis". Ninguem preenche
/// um campo a cada lancamento; na categoria o admin preenche UMA vez e todo
/// lancamento daquela categoria herda.
///
/// Nulo continua sendo possivel (categoria nova, ou lancamento sem categoria),
/// e nesse caso o valor aparece numa LINHA PROPRIA do DRE — nunca dobrado em
/// outra em silencio.
/// Com que passo a recorrencia se repete.
///
/// UMA lista. O ERP de origem tem duas divergentes — a expansao virtual dele
/// entende `semanal`/`quinzenal`/`mensal` e o gerador entende
/// `bimestral`/`trimestral`/`semestral`/`anual`, entao uma recorrencia
/// trimestral aparece num caminho e nao no outro. Aqui o passo e sempre em
/// MESES, o que tambem mantem a competencia sempre definida.
enum FrequenciaRecorrencia {
  mensal
  bimestral
  trimestral
  semestral
  anual
}

enum ClassificacaoDre {
  /// Imposto sobre a receita (Simples Nacional). Sai da receita bruta.
  deducao
  /// Custo que acompanha o numero de provedores atendidos.
  custo_variavel
  /// Estrutura: fixo, pessoal, administrativo.
  despesa_operacional
}

/// Classificador simples (Aluguel, Infraestrutura, Mensalidade de provedor...).
/// NAO e plano de contas: hierarquia com codigo "1.1.01" e capacidade de outra
/// fatia, e misturar as duas coisas agora deixaria a arvore pela metade.
model CategoriaFinanceira {
  id       String         @id @default(uuid())
  nome     String         @unique
  tipo     LancamentoTipo
  cor      String         @default("#6366f1")
  ativo    Boolean        @default(true)
  criadoEm DateTime       @default(now())

  /// So faz sentido em categoria de DESPESA — receita nao se classifica, ela
  /// e a primeira linha do DRE. Nulo = ainda nao classificada; o relatorio
  /// mostra o valor separado em vez de escolher uma linha por conta propria.
  classificacao ClassificacaoDre?

  lancamentos   Lancamento[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]

  @@map("categorias_financeiras")
}

model Lancamento {
  id     String @id @default(uuid())
  /// Identificador humano ("o lancamento 231"). uuid nao serve pra conversa
  /// entre duas pessoas olhando a mesma tela.
  numero Int    @unique @default(autoincrement())

  tipo      LancamentoTipo
  status    LancamentoStatus @default(pendente)
  descricao String           @db.VarChar(200)

  /// Decimal, NUNCA float. A API serializa como string e o cliente nunca soma
  /// dinheiro — totais saem de aggregate (o SUM do Postgres sobre numeric e
  /// exato). 14,2 comporta ate 999.999.999.999,99.
  valor Decimal @db.Decimal(14, 2)

  /// Data CIVIL (@db.Date), nao instante. Vencimento com hora arrastaria o
  /// bug classico de fuso: meia-noite UTC vira o dia anterior em BRT e a tela
  /// mostra um dia a menos. @db.Date remove a classe inteira na origem.
  vencimento DateTime @db.Date
  /// Mes de referencia, sempre no dia 1. Separado do vencimento de proposito:
  /// a mensalidade de marco que vence 10/abril PERTENCE a marco. Sem esta
  /// coluna, relatorio por competencia so mentiria.
  competencia DateTime @db.Date

  // --- baixa ---
  pagoEm         DateTime?       @db.Date
  /// Pode divergir de `valor` (juros, multa, desconto).
  valorPago      Decimal?        @db.Decimal(14, 2)
  formaPagamento FormaPagamento?

  /// Contraparte: o provedor que deve a hub. Null nas despesas da propria hub.
  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  /// Comprovante (bytes-in-postgres, mesmo padrao de Mensagem.anexoDados —
  /// inclusive o mesmo caminho de migracao pra S3/MinIO documentado la, que
  /// nao muda o contrato da API).
  comprovanteDados   Bytes?
  comprovanteMime    String?
  comprovanteNome    String? @db.VarChar(200)
  comprovanteTamanho Int?

  /// Quando esta ocorrencia veio de uma regra de recorrencia.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  /// Quando esta linha e uma PARCELA de uma compra parcelada.
  parcelamentoId String?
  parcelamento   Parcelamento? @relation(fields: [parcelamentoId], references: [id], onDelete: SetNull)
  /// 1..quantidade. Junto com parcelamentoId forma a trava de idempotencia.
  numeroParcela  Int?

  criadoPorId String?
  criadoPor   Usuario? @relation("LancamentosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  eventos LancamentoEvento[]

  /// Cobre exatamente a consulta de vencidos (status=pendente AND vencimento <
  /// hoje), que e o preco de derivar "atrasado" em vez de grava-lo.
  /*
   * A TRAVA DE IDEMPOTENCIA da recorrencia, no banco.
   *
   * O gerador pode rodar quantas vezes quiser: uma segunda tentativa de criar a
   * ocorrencia do mesmo vencimento bate aqui. E a diferenca entre este modelo e
   * o do ERP de origem, cujo botao de sincronizar inseria sem verificar nada —
   * cada clique criava um conjunto completo novo, e o proprio changelog deles
   * registra "tres chamadas seguidas deixam 12 lancamentos, nao 36" como
   * CORRECAO. Garantir isso em JavaScript e garantir ate o primeiro retry.
   */
  @@unique([recorrenciaId, vencimento])
  /// Mesma logica da recorrencia: gerar duas vezes nao cria a parcela 2 duas vezes.
  @@unique([parcelamentoId, numeroParcela])
  @@index([status, vencimento])
  @@index([tipo, competencia])
  @@index([provedorId])
  @@map("lancamentos")
}

/// Trilha de auditoria. Dinheiro sem "quem marcou como pago" nao resolve
/// divergencia nenhuma. Mesmo padrao do OsEvento.
model LancamentoEvento {
  id           String               @id @default(uuid())
  lancamentoId String
  lancamento   Lancamento           @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  tipo         LancamentoEventoTipo
  autorId      String?
  autor        Usuario?             @relation("LancamentoEventos", fields: [autorId], references: [id], onDelete: SetNull)
  /// Diferenca aplicada. Valores monetarios aqui tambem vao como STRING —
  /// um Number no JSON ja perdeu a garantia do decimal.
  detalhe      Json?
  criadoEm     DateTime             @default(now())

  @@index([lancamentoId, criadoEm])
  @@map("lancamento_eventos")
}

/// Regra que gera lancamentos repetidos — a mensalidade que cada provedor paga
/// a hub, o aluguel, a contabilidade.
///
/// AS OCORRENCIAS SAO LANCAMENTOS DE VERDADE, materializadas por um job. A
/// alternativa (expandir na leitura e pagar por uma tabela de "override", que e
/// o caminho do ERP de origem) foi descartada por uma limitacao que a propria
/// documentacao deles registra: no override "valor pago diferente, metodo,
/// chave fiscal e a nota nao sao persistidos por ocorrencia". Aqui cada
/// ocorrencia e um `Lancamento` inteiro — ela ja tem baixa com valor e forma
/// proprios, comprovante, historico, e entra no DRE e na inadimplencia sem uma
/// linha de codigo especial.
///
/// O preco de materializar e o risco de DUPLICAR, que foi exatamente o que
/// aconteceu la: o botao de sincronizar deles inseria sem verificar nada, e
/// cada clique criava um conjunto completo novo. Aqui a trava e
/// `@@unique([recorrenciaId, vencimento])` no Lancamento — no BANCO, nao no
/// JavaScript. Rodar o job duas vezes, um retry, ou dois containers num deploy
/// sobreposto nao tem como cobrar em dobro.
model Recorrencia {
  id        String                @id @default(uuid())
  tipo      LancamentoTipo
  descricao String                @db.VarChar(200)
  valor     Decimal               @db.Decimal(14, 2)
  frequencia FrequenciaRecorrencia @default(mensal)

  /// Dia do vencimento (1-31). Guardado como NUMERO, e o vencimento de cada mes
  /// e calculado com clamp ao ultimo dia daquele mes.
  ///
  /// Nao e detalhe: somar "+1 mes" a partir do dia 31 encolhe PERMANENTEMENTE
  /// (31/07 -> 31/08 -> 30/09 -> ... -> 28/02 -> 28/03), e o deslize pra tras
  /// ainda faz caber uma 13a ocorrencia na janela de 12 meses. Foi observado ao
  /// vivo no ERP de origem. Recalcular do dia guardado a cada mes nao desliza.
  diaVencimento Int

  /// Primeira competencia (dia 1 do mes). O gerador anda em passos de mes a
  /// partir daqui — nunca a partir da ocorrencia anterior.
  inicio DateTime  @db.Date
  /// Null = indefinida. Recorrencia permanente e permanente mesmo.
  fim    DateTime? @db.Date

  ativa Boolean @default(true)

  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  criadoPorId String?
  criadoPor   Usuario? @relation("RecorrenciasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentos Lancamento[]

  @@index([ativa, tipo])
  @@map("recorrencias")
}


/// Compra dividida em N parcelas — diferente da recorrencia, que e indefinida.
///
/// Todas as parcelas nascem de uma vez: o total e o numero de vezes ja sao
/// conhecidos, entao nao ha janela movel nem job. Cada parcela e um
/// `Lancamento` normal, com baixa, comprovante e historico proprios.
model Parcelamento {
  id         String         @id @default(uuid())
  tipo       LancamentoTipo
  descricao  String         @db.VarChar(200)
  /// A soma das parcelas fecha EXATAMENTE neste valor — a divisao e feita em
  /// centavos inteiros e a sobra vai pra ultima parcela (ver dividirEmParcelas).
  valorTotal Decimal        @db.Decimal(14, 2)
  quantidade Int

  primeiroVencimento DateTime @db.Date

  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  criadoPorId String?
  criadoPor   Usuario? @relation("ParcelamentosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  lancamentos Lancamento[]

  @@map("parcelamentos")
}
