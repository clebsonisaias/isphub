// ISPhub — schema do banco espelho.
// Toda entidade operacional carrega provedorId: e o que sustenta a fila
// unificada (todos os provedores) e, ao mesmo tempo, o destaque/filtro por
// provedor (badge com cor + logo) na UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  gestor
  tecnico
  provedor
}

enum ErpTipo {
  SGP
}

enum OsStatus {
  aberta
  em_deslocamento
  em_execucao
  concluida
  cancelada
  pendente
}

/// Tipo de evento na timeline de uma OS.
/// A metade do dia em que a visita foi marcada.
///
/// NAO e o mesmo "turno" de `JornadaTecnico` (bater ponto). Sao dois conceitos
/// que a operacao chama pelo mesmo nome, e por isso este carrega Agenda no
/// nome: um e a metade do DIA CIVIL, o outro e o expediente de UMA pessoa.
enum TurnoAgenda {
  manha
  tarde
}

enum StatusAgendamento {
  marcado
  cancelado
}

enum OsEventoTipo {
  atribuicao
  status
  anotacao
  foto
  edicao
  /// Mudanca do status do CONTRATO (nao da OS) feita a partir desta OS.
  /// A trilha nasce junto com a funcionalidade: o ERP de referencia registra em
  /// comentario que teve um incidente de "mudancas via URA sem rastro".
  contrato
}

model Provedor {
  id       String   @id @default(uuid())
  nome     String
  cor      String   @default("#6366f1")
  logoUrl  String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  erpConfigs    ErpConfig[]
  atendaiConfig AtendaiConfig?
  chaveParceiro ChaveParceiro?
  tiposOs       TipoOs[]
  ordensServico OrdemServico[]
  usuarios      Usuario[]
  syncLogs      SyncLog[]
  agendamentos  Agendamento[]
  /// Lancamentos em que este provedor e a CONTRAPARTE (quem deve a hub).
  /// Diferente de todas as relacoes acima: nao e particao multi-tenant.
  lancamentos   Lancamento[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]

  /// Frota: aqui `provedorId` VOLTA a ser particao multi-tenant (diferente dos
  /// tres acima) — so que NULAVEL, porque existe frota da propria operacao.
  veiculos          Veiculo[]
  rastreadores      Rastreador[]
  rastreadorConfigs RastreadorConfig[]

  @@map("provedores")
}

/// Credenciais de acesso ao ERP de um provedor. O token e armazenado
/// criptografado (AES-256-GCM) — ver src/lib/crypto.ts — nunca em claro.
/// A ligacao deste provedor com o AtendAI (a plataforma de atendimento dele).
///
/// UMA chave por provedor, e nao uma da plataforma inteira: no AtendAI a chave
/// pertence a um tenant (`req.sistemaExterno.tenantId`). E e justamente isso
/// que faz a regra do produto funcionar — a OS diz o provedor, o provedor diz a
/// chave, a chave diz o tenant, e o tecnico cai no cliente certo.
///
/// A ausencia desta linha NAO e erro: provedor sem AtendAI segue no caminho
/// atual (canal WhatsApp proprio do ISPhub). Por isso `chamar()` devolve null
/// em vez de lancar.
model AtendaiConfig {
  id         String   @id @default(uuid())
  provedorId String   @unique
  provedor   Provedor @relation(fields: [provedorId], references: [id], onDelete: Cascade)

  /// Ex.: `https://atendai.citmax.com.br`. Sem barra no fim.
  baseUrl String

  /// Chave de API cifrada (iv:authTag:ciphertext em base64), igual ao token do
  /// SGP. NUNCA volta em GET nem vai pra log.
  chaveCifrada String

  /// Segredo que o AtendAI devolve ao registrar o webhook de saida. E com ele
  /// que se valida a assinatura do que chega — sem isso, qualquer um posta
  /// mensagem no chat da equipe.
  segredoCifrado String?

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("atendai_configs")
}

/// A chave que um sistema PARCEIRO usa pra entrar aqui pela API de
/// agendamento (`/api/parceiro/v1/agenda`). Uma por provedor.
///
/// Morava em `AtendaiConfig` ate 07/10/2026, quando o unico parceiro era o
/// AtendAI. Saiu de la porque a API e a mesma pra qualquer sistema do
/// provedor, e exigir o cadastro do AtendAI pra gerar a chave de outro
/// sistema nao fazia sentido.
///
/// HASH, nao cifrada: nunca precisa ser lida de volta, so comparada. Mostrada
/// UMA vez, ao gerar.
model ChaveParceiro {
  id         String   @id @default(uuid())
  provedorId String   @unique
  provedor   Provedor @relation(fields: [provedorId], references: [id], onDelete: Cascade)

  hash String

  /// Os 12 primeiros caracteres em claro: lookup sem varrer a tabela, e a
  /// tela mostra QUAL chave esta ativa sem revelar nenhuma.
  prefixo String @unique

  /// Nome do sistema que usa a chave ("AtendAI", "ERP X") — so pra tela.
  rotulo String?

  /// Best-effort: ultimo uso. E como se descobre integracao parada em silencio.
  usoEm DateTime?

  criadoEm DateTime @default(now())

  @@map("chaves_parceiro")
}

model ErpConfig {
  id                       String    @id @default(uuid())
  provedorId               String
  provedor                 Provedor  @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  tipo                     ErpTipo   @default(SGP)
  url                      String
  app                      String
  /// Token criptografado (iv:authTag:ciphertext em base64).
  tokenCifrado             String
  intervaloPollingSegundos Int       @default(60)
  ativo                    Boolean   @default(true)
  ultimaSyncEm             DateTime?
  ultimaSyncOk             Boolean?
  ultimaSyncMensagem       String?
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt

  @@unique([provedorId, tipo])
  @@map("erp_configs")
}

/// Categoria canonica da ISPhub (global, nao por provedor) — taxonomia unica
/// pra unificar os "motivos"/tipos de OS de cada SGP, que cada provedor nomeia
/// diferente (ex.: "Instalacao" x "Novo cliente" x "Ativacao" sao a mesma
/// categoria em provedores distintos). Ver [[categoriaMatch.ts]] para o
/// auto-mapeamento por palavra-chave.
model Categoria {
  id             String   @id @default(uuid())
  nome           String   @unique
  cor            String   @default("#6366f1")
  /// Nome de icone lucide (ex.: "wrench", "wifi-off"). Opcional.
  icone          String?
  /// Palavras-chave (normalizadas: minusculas, sem acento/emoji) usadas pelo
  /// auto-mapeamento pra sugerir esta categoria a partir da descricao do tipo.
  palavrasChave  String[] @default([])
  /// SLA herdado por tipos mapeados sem SLA proprio definido.
  slaHorasPadrao Int?
  /// Marca categorias cujas OS sao executadas por equipe de FORA (do proprio
  /// provedor), nao pela equipe da ISPhub — ex.: retirada/cancelamento de
  /// equipamento. Elas saem da fila/mapa/alertas de SLA da operacao e ganham
  /// tela propria (ver equipeService.ts). Fica na categoria (nao no nome do
  /// tipo) porque cada SGP nomeia o tipo do seu jeito e o admin ja mantem
  /// essa taxonomia em Categoria, nao em TipoOs.
  equipeExterna  Boolean  @default(false)
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())

  tiposOs TipoOs[]

  @@map("categorias")
}

/// Tipo de OS importado do catalogo do ERP e exibido no ISPhub.
model TipoOs {
  id          String     @id @default(uuid())
  provedorId  String
  provedor    Provedor   @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  sgpCodigo   String
  descricao   String
  /// null = "Nao classificado" (aguardando mapeamento manual ou auto-match).
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  visivel     Boolean    @default(true)
  /// Prazo de SLA em horas; null = sem SLA proprio (usa o padrao da categoria).
  slaHoras    Int?

  ordensServico OrdemServico[]

  @@unique([provedorId, sgpCodigo])
  @@map("tipos_os")
}

/// Ordem de Servico espelhada do ERP do provedor.
model OrdemServico {
  id                       String    @id @default(uuid())
  provedorId               String
  provedor                 Provedor  @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  sgpOsId                  String
  tipoOsId                 String?
  tipoOs                   TipoOs?   @relation(fields: [tipoOsId], references: [id], onDelete: SetNull)
  status                   OsStatus  @default(aberta)
  prioridade               Int       @default(2)
  clienteNome              String?
  clienteDocumento         String?
  /// Telefone/contato do cliente, do cadastro no SGP (/api/ura/clientes/) —
  /// a listagem de OS nao traz, vem no mesmo backfill do endereco/geo.
  telefone                 String?
  contratoId               String?
  protocolo                String?
  conteudo                 String?
  observacao               String?
  logradouro               String?
  numero                   String?
  bairro                   String?
  cidade                   String?
  lat                      Float?
  lng                      Float?
  /// Localidade/POP do SGP (ex.: "Macaíba") — o SGP nao expoe endereco de
  /// rua nas listagens de OS, isso e o dado de localizacao mais
  /// fino disponivel.
  pop                      String?
  /// Status do contrato no SGP no momento do sync (ex.: "Ativo",
  /// "Cancelado"). Usado para alertar o gestor/tecnico antes de despachar
  /// para um contrato ja cancelado/suspenso.
  contratoStatus           String?
  /// Usuario do SGP que registrou a OS (auditoria).
  usuario                  String?
  /// Data/hora reais de abertura no SGP (data_cadastro+hora_cadastro) —
  /// distinta de criadoEm, que so reflete quando o ISPhub sincronizou pela
  /// primeira vez.
  dataCadastro             DateTime?
  dataAgendamento          DateTime?
  /// Tecnico ISPhub atribuido (Usuario com role=tecnico) — despacho feito
  /// dentro do ISPhub, nao vem do SGP.
  tecnicoId                String?
  tecnico                  Usuario?  @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  /// Nome do tecnico designado no SGP do provedor (informativo — o SGP e de
  /// pessoal do provedor, nao do tecnico ISPhub que de fato executa a OS).
  tecnicoSgpNome           String?
  /// Marca quando o alerta de "SLA estourado" ja foi disparado pra esta OS —
  /// evita notificar de novo a cada tick do slaAlertScheduler.
  slaNotificadoEm          DateTime?
  /// Quando o status foi alterado por acao humana no ISPhub (writebackService),
  /// nao pelo sync. Usado pra sync nao sobrescrever, por uma janela de graca,
  /// um status recem-confirmado com o SGP enquanto a leitura do SGP ainda
  /// nao refletiu a escrita (consistencia eventual do lado do SGP).
  statusAlteradoEm         DateTime?
  /// Quando a observacao (eco local da ultima anotacao) foi alterada por
  /// acao humana — mesma logica do statusAlteradoEm, mas pro campo
  /// observacao: o SGP nao expoe historico de anotacoes pra confirmar a
  /// escrita, entao o sync so volta a confiar na leitura dele apos a janela
  /// de graca (ver syncService.ts).
  observacaoAlteradaEm     DateTime?
  /// Quando o status do CONTRATO foi alterado por acao humana daqui. Mesma
  /// janela de graca do statusAlteradoEm: o SGP aceita a escrita mas a leitura
  /// seguinte ainda devolve o valor antigo por alguns ciclos.
  contratoStatusAlteradoEm DateTime?
  /// Quantos ciclos de sync SEGUIDOS o SGP confirmou (com 404) que esta OS nao
  /// existe mais. Zera sozinho assim que ela reaparece na varredura. Uma
  /// confirmacao so nao cancela: em ago/2026 o sync cancelou OS que o SGP
  /// estava listando no mesmo minuto, e exigir repeticao torna um engano
  /// pontual inofensivo (ver a reconciliacao em syncService.ts).
  ausenciasConsecutivas    Int       @default(0)
  /// Quando o aviso de "OS nova" foi disparado. Trava o alerta em UMA vez por
  /// OS — sem isto o job avisaria a mesma OS a cada minuto. Nulo = ainda nao
  /// avisada; a migracao preenche as JA existentes com a data de entao, senao o
  /// primeiro tick despejaria o acervo inteiro no sino de todo mundo.
  novaNotificadaEm         DateTime?
  /// Quando o backfill tentou puxar o cadastro do cliente (/api/ura/clientes/)
  /// pra esta OS — a listagem de OS do SGP nao traz endereco de rua, geo nem
  /// telefone, so esse endpoint traz. Marca a TENTATIVA (com ou sem dado) pra
  /// nao reconsultar pra sempre um contrato que o SGP nao detalha; reconsulta
  /// so apos um TTL (ver syncService.ts).
  geoConsultadoEm          DateTime?
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt
  sincronizadoEm           DateTime  @default(now())

  atribuicoes  Atribuicao[]
  eventos      OsEvento[]
  notificacoes Notificacao[]
  /// Thread de chat da OS — no maximo 1 por OS (ver Conversa.ordemServicoId @unique).
  conversa     Conversa?
  /// Ocupacoes abertas ESPECIFICAMENTE pra esta OS — o caso raro. O normal e
  /// descobrir o veiculo cruzando a janela de execucao com as ocupacoes do
  /// tecnico; ver `veiculosDaOs`.
  deslocamento DeslocamentoOs?
  auditoriaVisita AuditoriaVisita?
  ocupacoes    OcupacaoVeiculo[]
  /// A marcacao na agenda da ISPhub, quando existe. Chega DEPOIS da OS em
  /// alguns casos e ANTES dela em outros — ver o comentario em `Agendamento`.
  agendamento  Agendamento?

  @@unique([provedorId, sgpOsId])
  @@index([provedorId, status])
  @@index([status, dataAgendamento])
  @@index([tecnicoId])
  @@map("ordens_servico")
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  senhaHash         String
  role              UserRole
  /// Preenchido apenas para role=provedor (escopa o acesso a um unico provedor).
  provedorId        String?
  provedor          Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now())
  /// Versao da sessao. Vai dentro do JWT; `requireAuth` compara com o valor do
  /// banco e recusa o token se diferir. E o unico jeito de INVALIDAR um token
  /// ja emitido — sem isto, desativar o usuario, trocar a senha, rebaixar o
  /// papel ou mudar o provedorId nao derrubava nada: o token velho continuava
  /// valendo (com o papel ANTIGO) por ate 8h em todas as rotas.
  /// Incrementa em: desativacao, troca de papel, troca de provedor e troca de
  /// senha. Ver services/authService.ts e routes/usuarios.ts.
  tokenVersion      Int       @default(0)
  /// Presenca barata do chat: atualizado (com throttle de ~60s, ver
  /// middleware de presenca) a cada request autenticado. online = visto nos
  /// ultimos ~2min — nunca calculado no cliente.
  ultimaAtividadeEm DateTime?

  /// Foto de perfil (bytes-in-postgres, mesmo padrao do anexo de chat —
  /// Mensagem.anexoDados). Null = sem foto, cliente cai pro circulo de iniciais.
  fotoDados   Bytes?
  fotoMime    String?
  /// Denormalizado: evita selecionar fotoDados (bytes crus) em toda query de
  /// lista de contatos/mensagens so pra saber se a foto existe.
  temFoto     Boolean @default(false)
  /// Incrementado a cada upload/remocao de foto. Nunca exibido — vira `?v=`
  /// no path da foto (GET /auth/foto/:id?v=N) pra invalidar o cache local do
  /// app baseado-em-arquivo (ver baixarAnexoAutenticado em apps/mobile),
  /// que senao guardaria a foto antiga pra sempre pela mesma chave de path.
  fotoVersao  Int     @default(0)
  /// Status manual (um StatusPreset — ver packages/shared). Sibling do
  /// `online` computado acima: nunca substitui a presenca automatica.
  status      String?
  /// Complemento livre opcional ao status (ex.: "cliente X ate 15h").
  statusTexto String? @db.VarChar(140)

  /// Apelido editavel exibido no chat/UI — `nome` continua fixo (cadastro).
  nomeExibicao    String? @db.VarChar(80)
  bio             String? @db.VarChar(280)
  /// Telefone de contato — distinto das credenciais de login (email/senha).
  telefoneContato String? @db.VarChar(30)
  /// Assinatura opcional anexada as mensagens do chat interno deste usuario.
  assinaturaChat  String? @db.VarChar(140)
  /// Cor de destaque pessoal (hex "#rrggbb") — sibling de Provedor.cor, mas de
  /// uso pessoal (perfil), nao de identidade de marca/badge cross-cutting.
  corDestaque     String? @db.VarChar(7)

  /// Ponteiro para a linha movel corporativa (chip CITmax/Brazmovel) deste
  /// usuario. Preenchido pelo ADMIN, no cadastro.
  ///
  /// **E o `lineId` da operadora, NAO o CPF, e isso e deliberado.** O CPF e a
  /// unica porta para DESCOBRIR a linha (`GET /customer/cpf/{cpf}`; as
  /// listagens gerais nao servem a este uso), mas nao e necessario para
  /// CONSULTA-LA — `/line/{id}` basta. Entao o admin digita o CPF uma vez, na
  /// tela de vinculo, e o que fica guardado e so este ponteiro opaco.
  ///
  /// Guardar o CPF cifrado teria custado tres coisas, todas evitadas aqui:
  ///  - `encrypt()` usa IV aleatorio, entao o mesmo CPF cifra diferente a cada
  ///    vez e um `@unique` NAO detectaria duplicata nenhuma;
  ///  - um digito errado no cadastro produziria uma tela que FUNCIONA, com a
  ///    linha de um estranho, indefinidamente e em silencio — com o lineId o
  ///    erro aparece na hora do vinculo, com um humano olhando;
  ///  - seria a primeira PII de funcionario em repouso no sistema (LGPD).
  ///
  /// Contrapartida aceita: trocar de chip nao se auto-corrige — a consulta passa
  /// a dar "linha nao encontrada" e o admin revincula. Falhar visivelmente num
  /// evento raro e melhor que acertar por acaso todo dia.
  brazmovelLineId String? @unique

  ordensServico OrdemServico[]
  atribuicoes   Atribuicao[]
  eventos       OsEvento[]
  notificacoes  Notificacao[]

  conversasCriadas  Conversa[]             @relation("ConversasCriadas")
  participacoesChat ConversaParticipante[]
  mensagens         Mensagem[]             @relation("MensagensDoAutor")
  mensagemReacoes   MensagemReacao[]

  conversasClienteAtendidas ConversaCliente[] @relation("ConversaClienteAgente")
  conversasClienteIniciadas ConversaCliente[] @relation("ConversaClienteIniciadaPor")
  mensagensClienteEnviadas  MensagemCliente[] @relation("MensagemClienteAutor")

  pushTokens PushToken[]

  sessoesRefresh    SessaoRefresh[]
  tokensRecuperacao TokenRecuperacaoSenha[]

  lancamentosCriados   Lancamento[]        @relation("LancamentosCriados")
  recorrenciasCriadas  Recorrencia[]       @relation("RecorrenciasCriadas")
  parcelamentosCriados Parcelamento[]      @relation("ParcelamentosCriados")
  abastecimentos       Abastecimento[]     @relation("AbastecimentosRegistrados")
  cartoesCombustivel   CartaoCombustivel[] @relation("CartoesCombustivel")
  lancamentoEventos    LancamentoEvento[]  @relation("LancamentoEventos")
  jornadas             JornadaTecnico[]

  /// Frota. As duas primeiras sao papeis DIFERENTES na mesma tabela: em quais
  /// veiculos esta pessoa esteve, e quais ocupacoes ela DECLAROU (dela ou de um
  /// colega). Sem separar, "quem me pos nesse carro?" nao teria resposta.
  ocupacoesVeiculo    OcupacaoVeiculo[]   @relation("OcupacoesVeiculo")
  escalas             EscalaJornada[]     @relation("EscalasDoTecnico")
  ocupacoesDeclaradas OcupacaoVeiculo[]   @relation("OcupacoesDeclaradas")
  vinculosRastreador  VinculoRastreador[] @relation("VinculosRastreador")

  @@map("usuarios")
}

/// Sessao longa do navegador (refresh token rotativo).
///
/// O access token (JWT, 8h) continua sendo a credencial de toda chamada; este
/// model e o que permite RENOVA-LO sem pedir a senha de novo. Separar os dois e
/// o que torna possivel "sessao que dura enquanto a pessoa usa" sem deixar um
/// token de 30 dias circulando em cada request.
///
/// O token cru NUNCA e gravado — so o SHA-256 dele. Um dump do banco nao
/// entrega sessao de ninguem, mesma logica de `senhaHash`.
model SessaoRefresh {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) do token cru. Unico: e por ele que a validacao busca.
  tokenHash  String    @unique
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  /// Ultima vez que este refresh foi trocado por um novo — e o que define
  /// "inatividade": ninguem renova, ninguem usa, a sessao morre em `expiraEm`.
  usadoEm    DateTime?
  /// Marca a rotacao. Tambem e o relogio da JANELA DE GRACA: um refresh
  /// apresentado logo apos ser queimado e a outra aba do mesmo usuario, nao
  /// um token roubado (ver refreshService.ts).
  revogadoEm DateTime?

  /// Contexto so pra exibir "de onde" numa futura tela de sessoes ativas.
  userAgent String? @db.VarChar(300)
  ip        String? @db.VarChar(64)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes_refresh")
}

/// Servidor de e-mail do ISPhub, editavel pelo admin.
///
/// Existia so como variavel de ambiente, o que obrigava um redeploy (e acesso
/// ao Coolify) pra trocar uma senha de SMTP. Mesmo desenho do
/// [[CanalWhatsappConfig]]: blob unico cifrado, `ativo`, e o resultado da
/// ultima verificacao — a senha nunca toca o disco em claro.
model SmtpConfig {
  id                        String    @id @default(uuid())
  /// Singleton: sempre "global". Existe pra dar um alvo estavel ao upsert.
  /// O SMTP e do ISPhub (quem manda o e-mail de recuperacao), nao de cada
  /// provedor — por isso um registro so, e nao um por provedorId.
  escopo                    String    @unique @default("global")
  /// JSON {host,port,secure,usuario,senha,remetente} cifrado como UM blob
  /// via encrypt() — mesmo formato de ErpConfig.tokenCifrado.
  configCifrado             String
  ativo                     Boolean   @default(true)
  /// Preenchidos pelo "enviar e-mail de teste": e a unica forma de saber que
  /// a configuracao funciona ANTES de alguem depender dela pra recuperar senha.
  ultimaVerificacaoEm       DateTime?
  ultimaVerificacaoOk       Boolean?
  ultimaVerificacaoMensagem String?
  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  @@map("smtp_config")
}

/// Token de uso unico pra redefinir senha sem estar logado.
///
/// Mesma regra do refresh: grava so o SHA-256. Quem tem acesso ao banco nao
/// consegue forjar o link que chega no e-mail.
model TokenRecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  /// Preenchido no primeiro uso — e o que impede reuso do mesmo link.
  usadoEm   DateTime?

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("tokens_recuperacao_senha")
}

enum PushPlataforma {
  android
  ios
}

/// Aparelho registrado para receber push (Expo Push Service).
///
/// A chave unica e o TOKEN, nao (usuario, token): o token identifica o
/// APARELHO. Se outro tecnico logar no mesmo celular, o registro tem que
/// migrar de dono — se fosse unico por par, o aparelho ficaria com dois donos e
/// o tecnico anterior continuaria recebendo as mensagens do novo (vazamento de
/// conversa entre pessoas que dividem aparelho, coisa comum em equipe de campo).
model PushToken {
  id         String         @id @default(uuid())
  /// Token do Expo (`ExponentPushToken[...]`).
  token      String         @unique
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plataforma PushPlataforma
  criadoEm   DateTime       @default(now())
  /// Toda vez que o app registra de novo — serve pra expirar aparelho parado.
  vistoEm    DateTime       @updatedAt

  @@index([usuarioId])
  @@map("push_tokens")
}

/// Turno de trabalho do tecnico — MARCADOR OPERACIONAL, nao ponto eletronico.
///
/// Responde "estou em servico desde as X" pra operacao. NAO vale como registro
/// de jornada da CLT (Portaria 671 exigiria registro inviolavel, espelho de
/// ponto e comprovante por marcacao); se um dia precisar valer, isto vira outro
/// modelo, nao um campo a mais neste.
///
/// Sem coluna de duracao: e `fimEm - inicioEm`. Guardar um total que o banco
/// sabe calcular e a receita de os dois discordarem.
///
/// ⚠️ INDICE PARCIAL FEITO A MAO. A migracao
/// `20260807T203000_jornada_tecnico` cria
/// `CREATE UNIQUE INDEX ... ON "jornadas_tecnico"("usuarioId") WHERE "fimEm" IS NULL`
/// — a garantia de UMA jornada aberta por tecnico. Indice parcial nao e
/// expressavel aqui no schema, entao um `prisma migrate diff` futuro vai propor
/// DROP desse indice. Esse DROP e uma REGRESSAO, nao limpeza: sem ele, dois
/// toques no botao viram duas jornadas e o "tempo trabalhado" vira ficcao.
model JornadaTecnico {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inicioEm  DateTime  @default(now())
  /// Nulo = jornada ABERTA. E o que o indice parcial acima observa.
  fimEm     DateTime?
  /// Onde o tecnico estava ao bater inicio/fim. Best-effort: permissao negada
  /// nao pode impedir alguem de comecar o turno, entao sao nulaveis.
  latInicio Float?
  lngInicio Float?
  latFim    Float?
  lngFim    Float?

  /// A viatura declarada ao abrir o turno. Pode ser mais de uma: trocar de
  /// carro no meio do dia fecha uma ocupacao e abre outra, ambas da MESMA
  /// jornada — e as duas ficam no historico, em vez de a segunda sobrescrever.
  ocupacoes OcupacaoVeiculo[]

  /// Os intervalos parados dentro deste turno (almoco e afins).
  pausas PausaJornada[]

  @@index([usuarioId, inicioEm])
  @@map("jornadas_tecnico")
}

/// Um intervalo PARADO dentro da jornada — almoco, principalmente.
///
/// Existe porque sem ela o "tempo trabalhado" conta o almoco como trabalho, e
/// o numero que o supervisor usa pra medir o dia sai inflado na mesma medida
/// em todo mundo, todos os dias.
///
/// Mesmo formato de `OcupacaoVeiculo`: intervalo `[inicioEm, fimEm)` com
/// `fimEm` nulo significando ABERTO. Sem coluna de duracao, pela mesma razao
/// que a jornada nao tem — o banco ja sabe subtrair.
///
/// ⚠️ INDICE PARCIAL FEITO A MAO, igual ao da jornada. A migracao
/// `20260901T050000_pausa_jornada` cria
/// `CREATE UNIQUE INDEX ... ON "pausas_jornada"("jornadaId") WHERE "fimEm" IS NULL`
/// — a garantia de UMA pausa aberta por jornada. Um `prisma migrate diff`
/// futuro vai propor DROP dele; esse DROP e REGRESSAO: sem o indice, dois
/// toques em "Pausar" abrem duas pausas e o tempo e descontado em dobro.
model PausaJornada {
  id        String         @id @default(uuid())
  jornadaId String
  jornada   JornadaTecnico @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  inicioEm DateTime  @default(now())
  /// Nulo = EM PAUSA agora. E o que o indice parcial observa.
  fimEm    DateTime?

  motivo MotivoPausa @default(almoco)

  @@index([jornadaId, inicioEm])
  @@map("pausas_jornada")
}

/// A ESCALA do dia: quem vai em qual viatura, em que papel.
///
/// Inverte quem decide. Antes o tecnico declarava a viatura ao abrir o turno;
/// agora o supervisor escala, e o app do tecnico so MOSTRA. Quem responde por
/// carro, seguro e rodizio e a supervisao, nao quem esta com pressa pra sair.
///
/// SEM tabela de parceiros, de proposito: "vai com fulano" e o supervisor
/// escalar as duas pessoas pro MESMO veiculo no MESMO dia. Uma tabela de
/// parceiros seria um segundo lugar dizendo a mesma coisa, e os dois poderiam
/// discordar (A com B, sem B com A).
///
/// `veiculoId` NULO nao e "nao escalado" — e escalado A PE, decisao explicita.
/// "Nao escalado" e a ausencia da linha.
model EscalaJornada {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation("EscalasDoTecnico", fields: [usuarioId], references: [id], onDelete: Cascade)
  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  papel PapelOcupacao @default(motorista)

  /// Em quais turnos a pessoa trabalha neste dia. Dia inteiro = os dois.
  turnos TurnoAgenda[] @default([manha, tarde])

  /// Faltou. Marcado pelo supervisor; o job de "escalado sem jornada" so AVISA.
  ausenteEm      DateTime?
  motivoAusencia String?   @db.VarChar(120)

  /// Turnos em que o aviso "escalado e sem jornada" ja saiu — trava do job.
  avisosSemJornada TurnoAgenda[] @default([])

  /// O dia a que a escala se refere. DATE e nao timestamp: escala e do dia
  /// inteiro, e guardar hora convidaria a comparar instantes com fuso.
  dia DateTime @db.Date

  /// Quem escalou. Sem FK de proposito: se o gestor sair da empresa, a escala
  /// do passado nao pode sumir junto.
  definidoPor  String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Uma escala por pessoa por dia. Reescalar ATUALIZA, nao empilha.
  @@unique([usuarioId, dia])
  @@index([dia, veiculoId])
  @@map("escalas_jornada")
}

enum MotivoPausa {
  almoco
  outro
}

/// Despacho de uma OS para um tecnico (historico de atribuicoes).
model Atribuicao {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tecnicoId      String
  tecnico        Usuario      @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  atribuidoEm    DateTime     @default(now())
  atribuidoPor   String?

  @@index([ordemServicoId])
  @@index([tecnicoId])
  @@map("atribuicoes")
}

/// Timeline de uma OS: toda acao feita dentro do ISPhub (status, anotacao,
/// atribuicao, foto) vira um evento aqui. So nasce de acao humana — a criacao
/// da OS via sync nao gera evento. Fotos (tipo=foto) sao hospedadas no
/// proprio SGP (ver connectors/sgp.ts addOsImage/listOsImages) — o evento so
/// guarda a descricao, sem FK local pra nenhum arquivo.
model OsEvento {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipo           OsEventoTipo
  autorId        String?
  autor          Usuario?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  descricao      String
  /// Onde o tecnico estava quando isto aconteceu. Nulavel e best-effort: se a
  /// permissao de localizacao estiver negada, a acao (marcar a caminho,
  /// concluir) acontece do mesmo jeito — a posicao e complemento, nao requisito.
  ///
  /// Mora no EVENTO e nao na OrdemServico de proposito: na OS so caberia a
  /// ultima posicao, e o que interessa e o rastro — de onde ele disse que saiu,
  /// de onde disse que chegou, de onde disse que terminou.
  lat            Float?
  lng            Float?
  /// De onde e pra onde o status foi — ESTRUTURADO, e nao so dentro da frase.
  ///
  /// A `descricao` ("Status alterado: A caminho → Concluida") sempre teve os
  /// dois, mas como texto em portugues montado a partir de rotulos de tela.
  /// Perguntar "quantas OS fecharam hoje, e quem fechou" contra aquilo obriga a
  /// um `LIKE '%Concluida%'` — que passa a mentir no dia em que alguem corrigir
  /// o acento de um rotulo, sem erro nenhum, so com o numero errado. Um BI de
  /// PRODUTIVIDADE mede pessoas; ele nao pode depender de casar string.
  ///
  /// `statusDe` e nulo quando a transicao nao tinha origem conhecida (o evento
  /// "Marcado como a caminho" nunca a registrou); ambos sao nulos nos eventos
  /// que nao sao de status, e nos antigos que o backfill nao conseguiu ler —
  /// nulo aqui quer dizer "nao sabemos", nunca "nao mudou".
  statusDe       OsStatus?
  statusPara     OsStatus?
  criadoEm       DateTime     @default(now())

  @@index([ordemServicoId, criadoEm])
  /// A consulta do BI de produtividade: "todo fechamento no periodo".
  /// `autorId` entra no indice porque a distincao entre fechou-pelo-app e
  /// fechou-no-SGP (autor nulo) e lida em toda linha do resultado.
  @@index([statusPara, criadoEm, autorId])
  @@map("os_eventos")
}

/// Notificacao in-app pra um usuario (atribuicao de OS, SLA estourado).
model Notificacao {
  id             String        @id @default(uuid())
  usuarioId      String
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo           String
  mensagem       String
  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  lida           Boolean       @default(false)
  criadoEm       DateTime      @default(now())

  @@index([usuarioId, lida, criadoEm])
  @@map("notificacoes")
}

/// Estado EDITAVEL de um modulo do app do tecnico (Fase 2). Os metadados
/// imutaveis (nome, icone, se e core) vivem no codigo (shared: MODULO_CATALOGO);
/// aqui fica so o que o admin muda. `moduloId` e um dos MODULO_IDS (uniao
/// fechada, validada na aplicacao). Ausencia de registro = usa o padrao do
/// catalogo. Nao ha coluna `core` de proposito: core=false fica irrepresentavel.
model ModuloConfig {
  id              String   @id @default(uuid())
  moduloId        String   @unique
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  rolesPermitidos String[]
  atualizadoEm    DateTime @updatedAt

  @@map("modulo_configs")
}

/// Auditoria de cada ciclo de sync (pull) e write-back (push) por provedor.
model SyncLog {
  id         String   @id @default(uuid())
  provedorId String
  provedor   Provedor @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  direcao    String // "pull" | "push"
  recurso    String // "os" | "tipos" | "tecnicos" | ...
  ok         Boolean
  mensagem   String?
  quantidade Int?
  iniciadoEm DateTime @default(now())
  duracaoMs  Int?

  @@index([provedorId, iniciadoEm])
  @@map("sync_logs")
}

// ---- Chat interno de operacao ----
// Coordenacao de campo ancorada no trabalho (thread por OS), auditavel (soft
// delete, nunca apaga de verdade), restrita a equipe interna — PROVEDOR nunca
// participa (a guarda de verdade e no servidor: chatService.podeParticipar).

enum ConversaTipo {
  direta
  grupo
  os
  avisos
}

enum MensagemTipo {
  texto
  foto
  audio
  localizacao
  os_ref
  sistema
}

model Conversa {
  id               String        @id @default(uuid())
  tipo             ConversaTipo
  /// Titulo explicito (grupo/avisos) — DM e thread de OS derivam o titulo no
  /// servidor (nome do outro participante / "OS #sgpOsId"), nao fica salvo aqui.
  titulo           String?
  /// Thread de OS: no maximo 1 conversa por OS (idempotencia de
  /// garantirConversaDeOs vem desse @unique).
  ordemServicoId   String?       @unique
  ordemServico     OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  criadoPorId      String?
  criadoPor        Usuario?      @relation("ConversasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)
  /// Denormalizado: ordena a lista de conversas sem varrer mensagens (evita N+1).
  ultimaMensagemEm DateTime?
  arquivada        Boolean       @default(false)
  criadoEm         DateTime      @default(now())

  participantes ConversaParticipante[]
  mensagens     Mensagem[]

  @@index([tipo, ultimaMensagemEm])
  @@map("conversas")
}

model ConversaParticipante {
  id              String    @id @default(uuid())
  conversaId      String
  conversa        Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Pode renomear/adicionar/remover participante (grupo). Sem efeito em DM/OS/avisos.
  admin           Boolean   @default(false)
  /// Marca d'agua de leitura: nao-lidas = mensagens com criadoEm > este valor.
  /// Evita uma linha de "lido" por mensagem, que explodiria em volume.
  ultimaLeituraEm DateTime?
  silenciado      Boolean   @default(false)
  /// Saiu do grupo (soft — preserva o historico de quem participou quando).
  saiuEm          DateTime?

  @@unique([conversaId, usuarioId])
  @@index([usuarioId, conversaId])
  @@map("conversa_participantes")
}

model Mensagem {
  id             String       @id @default(uuid())
  conversaId     String
  conversa       Conversa     @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  /// null = mensagem do sistema ("Fulano assumiu a OS"), sem autor humano.
  autorId        String?
  autor          Usuario?     @relation("MensagensDoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  tipo           MensagemTipo
  /// Texto, legenda da foto, ou rotulo do sistema.
  corpo          String?
  /// Midia local (chat NAO e evidencia de OS — nao espelha o SGP, entao nao
  /// segue o padrao de proxy-ao-vivo das fotos de evidencia). Limite validado
  /// no servidor: foto <=400KB, audio <=60s e <=500KB (ver chatService). Se o
  /// volume crescer, migrar pra S3/MinIO e trocar `anexoDados` por uma URL —
  /// o contrato de API (Mensagem.anexoMime/anexoTamanho) nao muda.
  anexoDados     Bytes?
  anexoMime      String?
  anexoTamanho   Int?
  /// Audio, em segundos.
  duracaoSeg     Int?
  lat            Float?
  lng            Float?
  /// Card de OS compartilhado no chat (tipo os_ref).
  ordemServicoId String?
  respondendoAId String?
  respondendoA   Mensagem?    @relation("Respostas", fields: [respondendoAId], references: [id], onDelete: SetNull)
  respostas      Mensagem[]   @relation("Respostas")
  editadoEm      DateTime?
  /// SOFT DELETE — contexto operacional e prova; nada some do banco. Quem
  /// apagou fica so como String (mesmo padrao de Atribuicao.atribuidoPor —
  /// auditoria informativa, sem FK).
  apagadoEm      DateTime?
  apagadoPorId   String?
  criadoEm       DateTime     @default(now())

  reacoes MensagemReacao[]

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

model MensagemReacao {
  id         String   @id @default(uuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  emoji      String
  criadoEm   DateTime @default(now())

  @@unique([mensagemId, usuarioId, emoji])
  @@map("mensagem_reacoes")
}

// ---- Chat com clientes (WhatsApp) ----
// Separado de propósito de Conversa/Mensagem/ConversaParticipante (chat
// interno) — um cliente de WhatsApp não tem Usuario/login, só telefone, e
// ConversaParticipante.usuarioId é FK obrigatória. Ver plano da feature.

enum CanalWhatsapp {
  meta
  evolution
}

enum MensagemClienteDirecao {
  entrada
  saida
}

enum MensagemClienteTipo {
  texto
  imagem
  audio
  documento
  localizacao
  sistema
}

/// Quem deu o primeiro passo. `entrada` = cliente mandou mensagem (nasce no
/// webhook, sem staff envolvido). `saida` = staff iniciou por template HSM.
/// Existe separado de `iniciadaPorId` porque este ultimo vira null quando o
/// usuario e deletado (onDelete: SetNull) — e ai a conversa continuaria
/// parecendo entrante, virando visivel na regra de escopo errada.
enum OrigemConversaCliente {
  entrada
  saida
}

/// Config global (nao por provedor) de cada integracao WhatsApp — mirror de
/// ErpConfig sem provedorId: ha so UMA conta Meta + UMA instancia Evolution
/// pro ISPhub inteiro (decisao explicita do usuario).
model CanalWhatsappConfig {
  id                        String        @id @default(uuid())
  tipo                      CanalWhatsapp @unique
  /// JSON do config inteiro (phoneNumberId/accessToken/verifyToken/appSecret
  /// pra meta; baseUrl/apiKey/instanceName pra evolution) cifrado como UM
  /// blob via encrypt() ja existente — mesmo formato de ErpConfig.tokenCifrado.
  configCifrado             String
  ativo                     Boolean       @default(true)
  ultimaVerificacaoEm       DateTime?
  ultimaVerificacaoOk       Boolean?
  ultimaVerificacaoMensagem String?
  criadoEm                  DateTime      @default(now())
  atualizadoEm              DateTime      @updatedAt

  @@map("canais_whatsapp_configs")
}

/// Conversa com um CLIENTE via WhatsApp — sem Usuario do lado do cliente.
model ConversaCliente {
  id               String                @id @default(uuid())
  /// E.164 sem prefixo, ex "5584999999999". Mesmo numero em canais diferentes
  /// e uma conversa DISTINTA por canal (cada canal e um numero/instancia diferente).
  telefone         String
  canal            CanalWhatsapp
  /// Nome de perfil do WhatsApp do cliente — informativo, nunca chave.
  nomeContato      String?
  /// Quem esta atendendo AGORA. Muda com assumir/transferir — nao serve como
  /// chave de visibilidade do tecnico (transferir tiraria a conversa dele).
  agenteId         String?
  agente           Usuario?              @relation("ConversaClienteAgente", fields: [agenteId], references: [id], onDelete: SetNull)
  /// Quem INICIOU a conversa por template. null = entrante (nasceu do webhook).
  /// E a chave de visibilidade do TECNICO: ele so enxerga o que ele mesmo
  /// iniciou. Setado APENAS no create do upsert — no update nao se toca, senao
  /// um segundo tecnico disparando pro mesmo numero roubaria a thread do
  /// primeiro (ha uma unica thread por telefone+canal, ver @@unique abaixo).
  iniciadaPorId    String?
  iniciadaPor      Usuario?              @relation("ConversaClienteIniciadaPor", fields: [iniciadaPorId], references: [id], onDelete: SetNull)
  origem           OrigemConversaCliente @default(entrada)
  arquivada        Boolean               @default(false)
  ultimaMensagemEm DateTime?
  criadoEm         DateTime              @default(now())

  mensagens MensagemCliente[]

  @@unique([telefone, canal])
  @@index([canal, arquivada, ultimaMensagemEm])
  @@index([agenteId])
  /// Escopo do tecnico filtra por este campo em toda listagem — sem indice a
  /// lista degrada junto com o volume de conversas.
  @@index([iniciadaPorId])
  @@map("conversas_clientes")
}

model MensagemCliente {
  id           String                 @id @default(uuid())
  conversaId   String
  conversa     ConversaCliente        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  /// Denormalizado de conversa.canal — so pro @@unique abaixo (webhooks
  /// WhatsApp reentregam o mesmo evento; isto torna a ingestao idempotente).
  canal        CanalWhatsapp
  direcao      MensagemClienteDirecao
  /// Staff que enviou (direcao=saida). Null em mensagens do cliente/sistema.
  autorId      String?
  autor        Usuario?               @relation("MensagemClienteAutor", fields: [autorId], references: [id], onDelete: SetNull)
  tipo         MensagemClienteTipo
  corpo        String?
  /// Midia recebida do WhatsApp — baixada e persistida (URLs da Meta expiram
  /// ~5min, nao da pra so referenciar). Teto de 5MB, ver LIMITE_MIDIA_CLIENTE_BYTES.
  anexoDados   Bytes?
  anexoMime    String?
  anexoTamanho Int?
  duracaoSeg   Int?
  lat          Float?
  lng          Float?
  /// Id da mensagem no provedor (wamid do Meta / id da Evolution).
  waMessageId  String
  /// Falha ao ENVIAR (direcao=saida) — erro do connector, exibido na bolha.
  falhaEnvio   String?
  /// Nome do template HSM disparado (so em mensagens que abriram conversa).
  /// `corpo` guarda o texto JA RENDERIZADO com as variaveis substituidas — o
  /// Maxxi grava so o marcador "[Template: nome]" e o atendente fica sem saber
  /// o que foi realmente enviado ao cliente.
  templateNome String?
  /// Variaveis efetivamente enviadas ({ "1": "Joao", "2": "10/08" }).
  templateVars Json?
  criadoEm     DateTime               @default(now())

  @@unique([canal, waMessageId])
  @@index([conversaId, criadoEm])
  @@map("mensagens_clientes")
}

// ---------------------------------------------------------------------------
// FINANCEIRO DA HUBISP
//
// Este bloco e o UNICO do schema que nao fala do assinante do provedor. Aqui o
// dinheiro e da propria HubISP: o que cada provedor paga a ela (contrato
// provedor<->hub) e o que ela mesma gasta. Titulo, fatura e boleto de cliente
// final do SGP NAO entram — o conector SGP nem e consultado por este modulo.
//
// Consequencia que vale gravar: `Lancamento.provedorId` e CONTRAPARTE ("quem
// deve a hub"), nao particao multi-tenant ("de quem e este dado"). Todo o resto
// do schema usa provedorId como fronteira de acesso; aqui e campo de negocio,
// opcional, e o acesso e controlado por papel (so ADMIN por padrao).
// ---------------------------------------------------------------------------

enum LancamentoTipo {
  receita
  despesa
}

/// So o que e FATO. "Atrasado" nao esta aqui de proposito: e funcao pura de
/// (vencimento < hoje && status = pendente), derivada na leitura. Grava-lo
/// exigiria um job virando linhas, e entre duas execucoes o banco mentiria.
enum LancamentoStatus {
  pendente
  pago
  cancelado
}

enum FormaPagamento {
  pix
  boleto
  transferencia
  dinheiro
  cartao
  outro
}

enum LancamentoEventoTipo {
  criado
  editado
  baixado
  estornado
  cancelado
}

/// Onde a despesa entra no DRE.
///
/// Vive na CATEGORIA, nao no lancamento — e a diferenca que decide se o
/// relatorio presta. No ERP de origem esse campo fica em cada transacao, e a
/// propria documentacao deles registra o resultado: "despesas sem
/// classificacao caem silenciosamente em custos variaveis". Ninguem preenche
/// um campo a cada lancamento; na categoria o admin preenche UMA vez e todo
/// lancamento daquela categoria herda.
///
/// Nulo continua sendo possivel (categoria nova, ou lancamento sem categoria),
/// e nesse caso o valor aparece numa LINHA PROPRIA do DRE — nunca dobrado em
/// outra em silencio.
/// Com que passo a recorrencia se repete.
///
/// UMA lista. O ERP de origem tem duas divergentes — a expansao virtual dele
/// entende `semanal`/`quinzenal`/`mensal` e o gerador entende
/// `bimestral`/`trimestral`/`semestral`/`anual`, entao uma recorrencia
/// trimestral aparece num caminho e nao no outro. Aqui o passo e sempre em
/// MESES, o que tambem mantem a competencia sempre definida.
enum FrequenciaRecorrencia {
  mensal
  bimestral
  trimestral
  semestral
  anual
}

/// Os quatro tipos de provisao — os mesmos slugs da origem.
///
/// Uma provisao NAO e outra maquina: e uma Recorrencia com tipo preenchido. A
/// origem mantem um gerador separado so pra provisao (RPC
/// `generate_recurring_provision_transactions_v2`, "diferente do caminho das
/// despesas"), e e exatamente por isso que um dos dois duplicava e o outro nao
/// — dois caminhos pro mesmo problema divergem sozinhos.
enum TipoProvisao {
  previsivel
  folha
  tributos
  obrigatorio
}

enum ClassificacaoDre {
  /// Imposto sobre a receita (Simples Nacional). Sai da receita bruta.
  deducao
  /// Custo que acompanha o numero de provedores atendidos.
  custo_variavel
  /// Estrutura: fixo, pessoal, administrativo.
  despesa_operacional
}

/// Classificador simples (Aluguel, Infraestrutura, Mensalidade de provedor...).
/// NAO e plano de contas: hierarquia com codigo "1.1.01" e capacidade de outra
/// fatia, e misturar as duas coisas agora deixaria a arvore pela metade.
model CategoriaFinanceira {
  id       String         @id @default(uuid())
  nome     String         @unique
  tipo     LancamentoTipo
  cor      String         @default("#6366f1")
  ativo    Boolean        @default(true)
  criadoEm DateTime       @default(now())

  /// So faz sentido em categoria de DESPESA — receita nao se classifica, ela
  /// e a primeira linha do DRE. Nulo = ainda nao classificada; o relatorio
  /// mostra o valor separado em vez de escolher uma linha por conta propria.
  classificacao ClassificacaoDre?

  lancamentos   Lancamento[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]

  @@map("categorias_financeiras")
}

model Lancamento {
  id     String @id @default(uuid())
  /// Identificador humano ("o lancamento 231"). uuid nao serve pra conversa
  /// entre duas pessoas olhando a mesma tela.
  numero Int    @unique @default(autoincrement())

  tipo      LancamentoTipo
  status    LancamentoStatus @default(pendente)
  descricao String           @db.VarChar(200)

  /// Decimal, NUNCA float. A API serializa como string e o cliente nunca soma
  /// dinheiro — totais saem de aggregate (o SUM do Postgres sobre numeric e
  /// exato). 14,2 comporta ate 999.999.999.999,99.
  valor Decimal @db.Decimal(14, 2)

  /// Data CIVIL (@db.Date), nao instante. Vencimento com hora arrastaria o
  /// bug classico de fuso: meia-noite UTC vira o dia anterior em BRT e a tela
  /// mostra um dia a menos. @db.Date remove a classe inteira na origem.
  vencimento  DateTime @db.Date
  /// Mes de referencia, sempre no dia 1. Separado do vencimento de proposito:
  /// a mensalidade de marco que vence 10/abril PERTENCE a marco. Sem esta
  /// coluna, relatorio por competencia so mentiria.
  competencia DateTime @db.Date

  // --- baixa ---
  pagoEm         DateTime?       @db.Date
  /// Pode divergir de `valor` (juros, multa, desconto).
  valorPago      Decimal?        @db.Decimal(14, 2)
  formaPagamento FormaPagamento?

  /// Contraparte: o provedor que deve a hub. Null nas despesas da propria hub.
  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  /// A que VEICULO esta despesa pertence — manutencao, pneu, seguro, IPVA,
  /// multa, pedagio.
  ///
  /// Opcional porque a maioria dos lancamentos nao e de veiculo (mensalidade,
  /// folha, internet); obrigatorio, forcaria um veiculo falso em toda despesa.
  ///
  /// `SetNull` e nao `Cascade`: aposentar o carro nao pode apagar a despesa que
  /// a empresa de fato teve. O historico financeiro sobrevive ao veiculo.
  ///
  /// Combustivel continua chegando por `Abastecimento.lancamentoId` (1:1). O BI
  /// soma os dois caminhos sem contar duas vezes, porque o abastecimento aponta
  /// para o lancamento, e nao o contrario.
  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  /// Numero da nota fiscal, boleto ou contrato. E por ele que se concilia com o
  /// papel — sem campo proprio, isso ia parar na observacao e nao dava pra buscar.
  numeroDocumento String? @db.VarChar(60)

  /// Nota fiscal de SERVICO tomado.
  ///
  /// Um campo, nao uma tabela: e assim na origem tambem — "Pontuais" e
  /// "Servicos" sao a MESMA tabela (`lancamentos_pontuais`), distinguidas por
  /// `expense_type`. A doc deles registra isso explicitamente como divergencia
  /// doc-codigo; aqui e o desenho declarado.
  ehServico Boolean @default(false)

  /// Comprovante (bytes-in-postgres, mesmo padrao de Mensagem.anexoDados —
  /// inclusive o mesmo caminho de migracao pra S3/MinIO documentado la, que
  /// nao muda o contrato da API).
  comprovanteDados   Bytes?
  comprovanteMime    String?
  comprovanteNome    String? @db.VarChar(200)
  comprovanteTamanho Int?

  /// Quando esta ocorrencia veio de uma regra de recorrencia.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  /// Quando este lancamento e a despesa de um abastecimento.
  abastecimento Abastecimento?

  /// Quando esta linha e uma PARCELA de uma compra parcelada.
  parcelamentoId String?
  parcelamento   Parcelamento? @relation(fields: [parcelamentoId], references: [id], onDelete: SetNull)
  /// 1..quantidade. Junto com parcelamentoId forma a trava de idempotencia.
  numeroParcela  Int?

  criadoPorId String?
  criadoPor   Usuario? @relation("LancamentosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  eventos LancamentoEvento[]

  /// A TRAVA DE IDEMPOTENCIA da recorrencia, no banco.
  ///
  /// O gerador pode rodar quantas vezes quiser: uma segunda tentativa de criar a
  /// ocorrencia do mesmo vencimento bate aqui. E a diferenca entre este modelo e
  /// o do ERP de origem, cujo botao de sincronizar inseria sem verificar nada —
  /// cada clique criava um conjunto completo novo, e o proprio changelog deles
  /// registra "tres chamadas seguidas deixam 12 lancamentos, nao 36" como
  /// CORRECAO. Garantir isso em JavaScript e garantir ate o primeiro retry.
  @@unique([recorrenciaId, vencimento])
  /// Mesma logica da recorrencia: gerar duas vezes nao cria a parcela 2 duas vezes.
  @@unique([parcelamentoId, numeroParcela])
  /// Cobre exatamente a consulta de vencidos (status=pendente AND vencimento <
  /// hoje), que e o preco de derivar "atrasado" em vez de grava-lo.
  @@index([status, vencimento])
  @@index([tipo, competencia])
  @@index([provedorId])
  @@index([ehServico])
  @@index([veiculoId, competencia])
  @@map("lancamentos")
}

/// Trilha de auditoria. Dinheiro sem "quem marcou como pago" nao resolve
/// divergencia nenhuma. Mesmo padrao do OsEvento.
model LancamentoEvento {
  id           String               @id @default(uuid())
  lancamentoId String
  lancamento   Lancamento           @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  tipo         LancamentoEventoTipo
  autorId      String?
  autor        Usuario?             @relation("LancamentoEventos", fields: [autorId], references: [id], onDelete: SetNull)
  /// Diferenca aplicada. Valores monetarios aqui tambem vao como STRING —
  /// um Number no JSON ja perdeu a garantia do decimal.
  detalhe      Json?
  criadoEm     DateTime             @default(now())

  @@index([lancamentoId, criadoEm])
  @@map("lancamento_eventos")
}

/// Regra que gera lancamentos repetidos — a mensalidade que cada provedor paga
/// a hub, o aluguel, a contabilidade.
///
/// AS OCORRENCIAS SAO LANCAMENTOS DE VERDADE, materializadas por um job. A
/// alternativa (expandir na leitura e pagar por uma tabela de "override", que e
/// o caminho do ERP de origem) foi descartada por uma limitacao que a propria
/// documentacao deles registra: no override "valor pago diferente, metodo,
/// chave fiscal e a nota nao sao persistidos por ocorrencia". Aqui cada
/// ocorrencia e um `Lancamento` inteiro — ela ja tem baixa com valor e forma
/// proprios, comprovante, historico, e entra no DRE e na inadimplencia sem uma
/// linha de codigo especial.
///
/// O preco de materializar e o risco de DUPLICAR, que foi exatamente o que
/// aconteceu la: o botao de sincronizar deles inseria sem verificar nada, e
/// cada clique criava um conjunto completo novo. Aqui a trava e
/// `@@unique([recorrenciaId, vencimento])` no Lancamento — no BANCO, nao no
/// JavaScript. Rodar o job duas vezes, um retry, ou dois containers num deploy
/// sobreposto nao tem como cobrar em dobro.
model Recorrencia {
  id         String                @id @default(uuid())
  tipo       LancamentoTipo
  descricao  String                @db.VarChar(200)
  valor      Decimal               @db.Decimal(14, 2)
  frequencia FrequenciaRecorrencia @default(mensal)

  /// Dia do vencimento (1-31). Guardado como NUMERO, e o vencimento de cada mes
  /// e calculado com clamp ao ultimo dia daquele mes.
  ///
  /// Nao e detalhe: somar "+1 mes" a partir do dia 31 encolhe PERMANENTEMENTE
  /// (31/07 -> 31/08 -> 30/09 -> ... -> 28/02 -> 28/03), e o deslize pra tras
  /// ainda faz caber uma 13a ocorrencia na janela de 12 meses. Foi observado ao
  /// vivo no ERP de origem. Recalcular do dia guardado a cada mes nao desliza.
  diaVencimento Int

  /// Primeira competencia (dia 1 do mes). O gerador anda em passos de mes a
  /// partir daqui — nunca a partir da ocorrencia anterior.
  inicio DateTime  @db.Date
  /// Null = indefinida. Recorrencia permanente e permanente mesmo.
  fim    DateTime? @db.Date

  ativa Boolean @default(true)

  /// Null = recorrencia comum. Preenchido = PROVISAO daquele tipo.
  ///
  /// Um campo, nao um model novo: o que muda entre provisao e despesa
  /// recorrente e a classificacao e a tela, nao a regra de geracao. Duplicar o
  /// gerador e o que faz os dois divergirem.
  tipoProvisao TipoProvisao?

  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  criadoPorId String?
  criadoPor   Usuario? @relation("RecorrenciasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentos Lancamento[]

  @@index([ativa, tipo])
  @@index([tipoProvisao])
  @@map("recorrencias")
}

/// Compra dividida em N parcelas — diferente da recorrencia, que e indefinida.
///
/// Todas as parcelas nascem de uma vez: o total e o numero de vezes ja sao
/// conhecidos, entao nao ha janela movel nem job. Cada parcela e um
/// `Lancamento` normal, com baixa, comprovante e historico proprios.
model Parcelamento {
  id         String         @id @default(uuid())
  tipo       LancamentoTipo
  descricao  String         @db.VarChar(200)
  /// A soma das parcelas fecha EXATAMENTE neste valor — a divisao e feita em
  /// centavos inteiros e a sobra vai pra ultima parcela (ver dividirEmParcelas).
  valorTotal Decimal        @db.Decimal(14, 2)
  quantidade Int

  primeiroVencimento DateTime @db.Date

  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  observacao String? @db.VarChar(500)

  criadoPorId String?
  criadoPor   Usuario? @relation("ParcelamentosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  lancamentos Lancamento[]

  @@map("parcelamentos")
}

// ---------------------------------------------------------------------------
// FROTA
// ---------------------------------------------------------------------------

enum TipoCombustivel {
  gasolina
  etanol
  diesel
  gnv
  eletrico
}

enum TipoVeiculo {
  carro
  moto
  van
  caminhao
  utilitario
}

enum StatusVeiculo {
  ativo
  manutencao
  inativo
}

model Veiculo {
  id String @id @default(uuid())

  /// NULO = frota da PROPRIA operacao ISPhub (carro que atende varios
  /// provedores). Preenchido = carro daquele ISP.
  ///
  /// Nulo aqui NAO e "desconhecido", e um fato — mesma semantica de
  /// `Usuario.provedorId`. Ver `escopoVeiculoWhere`.
  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  /// SEMPRE na forma canonica: maiuscula, so [A-Z0-9]. "abc-1234" e "ABC1234"
  /// sao A MESMA placa — `normalizarPlaca()` em @isphub/shared e a unica dona
  /// dessa regra, e roda antes de todo INSERT/UPDATE.
  ///
  /// Unico GLOBAL, e nao por provedor: placa e unica no mundo real (Denatran).
  /// `@@unique([provedorId, placa])` seria pior — o Postgres trata NULL como
  /// distinto, entao N carros da propria operacao poderiam ter a mesma placa.
  placa   String        @unique
  /// Como a operacao CHAMA este carro no dia a dia — "C011", "Suporte 1".
  ///
  /// Placa identifica; apelido RECONHECE. Num mapa com quatro pontos, ninguem
  /// lembra que RGI4H16 e o carro do plantao — e a propria plataforma do
  /// rastreador ja batiza os aparelhos assim ("C011 - RGI4H16"), porque quem
  /// opera precisa disso.
  ///
  /// Nulo e o normal: o campo e conveniencia, e um carro sem apelido continua
  /// perfeitamente identificado pela placa.
  apelido String?       @db.VarChar(40)
  modelo  String        @db.VarChar(80)
  marca   String?       @db.VarChar(60)
  ano     Int?
  cor     String?       @db.VarChar(30)
  tipo    TipoVeiculo   @default(carro)
  status  StatusVeiculo @default(ativo)

  /// Odometro corrente, em km. Cache de LEITURA: a verdade e o maior entre o
  /// ultimo Abastecimento.km e o ultimo OcupacaoVeiculo.odometroFim. So sobe
  /// (ver `odometroMonotonico`), senao um digito a menos zera o historico.
  odometroKm Int?
  renavam    String? @db.VarChar(11)
  chassi     String? @db.VarChar(17)

  /// NAO existe coluna "em uso". Quem esta no veiculo agora e DERIVADO de haver
  /// ocupacao aberta. Guardar isso seria repetir o `current_driver_id` do ERP
  /// de referencia: uma coluna mutavel unica, sem historico, em que um
  /// abastecimento do mes passado resolve pro motorista de HOJE.
  ///
  /// `ativo` continua existindo porque /financeiro/frota le e escreve nele.
  /// `status` e a fonte rica; o service mantem `ativo = (status != inativo)`.
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  abastecimentos Abastecimento[]
  ocupacoes      OcupacaoVeiculo[]
  deslocamentos  DeslocamentoOs[]
  manutencoes    PlanoManutencao[]
  checklists     ChecklistViatura[]
  vinculos       VinculoRastreador[]
  eventos        EventoRastreador[]
  viagens        Viagem[]
  lancamentos    Lancamento[]
  escalas        EscalaJornada[]

  @@index([provedorId, status])
  @@map("veiculos")
}

/// Um abastecimento. Gera um Lancamento de despesa na MESMA transacao.
///
/// O vinculo com o financeiro e a FK `lancamentoId`, nao um booleano
/// "ja sincronizou". A origem guarda `synced_to_finance` ao lado de
/// `finance_transaction_id` — dois fatos sobre a mesma coisa, e o booleano pode
/// dizer "sim" com a FK vazia. Aqui a FK E a resposta.
model Abastecimento {
  id        String  @id @default(uuid())
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  data        DateTime        @db.Date
  /// Odometro no momento do abastecimento.
  km          Int
  litros      Decimal         @db.Decimal(10, 3)
  valorTotal  Decimal         @db.Decimal(14, 2)
  combustivel TipoCombustivel @default(gasolina)
  posto       String?         @db.VarChar(120)

  /**
   * Encheu o tanque?
   * Sem isso o km/l e mentira: com abastecimento parcial nao se sabe quanto
   * combustivel havia no tanque, entao a distancia percorrida nao corresponde
   * aos litros postos. O consumo so e calculado entre dois tanques CHEIOS
   * consecutivos — e o unico intervalo em que a conta fecha.
   */
  tanqueCheio Boolean @default(true)

  /// O lancamento de despesa gerado. Um por abastecimento.
  lancamentoId String?     @unique
  lancamento   Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  responsavelId String?
  responsavel   Usuario? @relation("AbastecimentosRegistrados", fields: [responsavelId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  /// Dois abastecimentos do mesmo veiculo no mesmo odometro sao lancamento
  /// duplicado, nao dois eventos.
  @@unique([veiculoId, km])
  @@index([veiculoId, data])
  @@map("abastecimentos")
}

enum MovimentoCartaoTipo {
  deposito
  consumo
  estorno
}

/// Cartao-combustivel de um usuario.
///
/// SEM coluna de saldo. A origem guarda `current_balance` no cartao E
/// `new_balance` em cada movimento — duas copias derivadas do mesmo fato, e
/// nenhuma delas e a lista de movimentos. Basta um movimento inserido fora de
/// ordem ou removido pra as tres versoes discordarem. Aqui o saldo e a SOMA dos
/// movimentos, calculada na leitura.
model CartaoCombustivel {
  id        String   @id @default(uuid())
  numero    String   @unique @db.VarChar(40)
  titularId String?
  titular   Usuario? @relation("CartoesCombustivel", fields: [titularId], references: [id], onDelete: SetNull)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  movimentos MovimentoCartao[]

  @@map("cartoes_combustivel")
}

model MovimentoCartao {
  id        String              @id @default(uuid())
  cartaoId  String
  cartao    CartaoCombustivel   @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  tipo      MovimentoCartaoTipo
  /// Sempre POSITIVO. O sinal vem do `tipo`, nao do numero — valor negativo
  /// gravado e a porta pra um "deposito" de -500 zerar o saldo sem rastro.
  valor     Decimal             @db.Decimal(14, 2)
  data      DateTime            @db.Date
  descricao String?             @db.VarChar(200)
  criadoEm  DateTime            @default(now())

  @@index([cartaoId, data])
  @@map("movimentos_cartao")
}

// ---------------------------------------------------------------------------
// FROTA — OCUPACAO E RASTREAMENTO
// ---------------------------------------------------------------------------

enum PapelOcupacao {
  motorista
  passageiro
}

/// De onde veio a afirmacao "fulano esta neste carro" — e o PESO dela.
///
/// `ajuste` > `jornada` > `declaracao`. A pessoa sabe melhor que o colega onde
/// ela esta; e o gestor, corrigindo depois com a informacao toda, sabe melhor
/// que os dois. Ver `decidirOcupacao` em @isphub/shared, que e onde a regra
/// mora (pura e testada).
enum OrigemOcupacao {
  /// Um COLEGA declarou que esta pessoa estava junto. A mais fraca.
  declaracao
  /// A propria pessoa declarou, ao abrir ou alterar a jornada dela.
  jornada
  /// Correcao manual de admin/gestor. Vence as duas.
  ajuste
}

enum EncerramentoOcupacao {
  jornada
  troca_veiculo
  ajuste
}

/// Quem estava em qual veiculo, QUANDO. Uma linha por PESSOA por periodo.
///
/// Nao ha cabecalho com participantes, de proposito. Tres razoes:
///
/// (a) o passageiro pode descer no meio do trajeto enquanto o motorista segue —
///     com cabecalho, a linha do participante precisaria do proprio periodo de
///     qualquer jeito, e o cabecalho so acrescentaria um caminho de escrita;
/// (b) o indice parcial "uma ocupacao aberta POR TECNICO" — que e a resposta
///     inteira de "quem vence" — so e expressavel na linha por pessoa;
/// (c) estar junto e DERIVADO de intervalos que se sobrepoem no mesmo veiculo,
///     que e a verdade. Um `grupoId` registraria quem foi DECLARADO junto, um
///     fato mais fraco, livre pra discordar dos intervalos.
///
/// A origem tinha `tecnico_veiculo_dia` com PK so em `agente_id`: a atribuicao
/// de hoje SOBRESCREVIA a de ontem, entao nao havia historico nenhum — e o
/// `veiculo_id` sem FK, entao a que existia podia apontar pra nada.
model OcupacaoVeiculo {
  id        String  @id @default(uuid())
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  usuarioId String
  usuario   Usuario @relation("OcupacoesVeiculo", fields: [usuarioId], references: [id], onDelete: Restrict)

  inicioEm DateTime  @default(now())
  /// Nulo = ocupacao ABERTA. E o que os indices parciais observam.
  ///
  /// O intervalo e SEMIABERTO `[inicioEm, fimEm)` em toda consulta: numa troca
  /// de viatura as 13:30 em ponto, com intervalo fechado dos dois lados a
  /// pessoa estaria nos DOIS carros.
  fimEm    DateTime?

  papel  PapelOcupacao  @default(motorista)
  origem OrigemOcupacao

  /// Quem afirmou. Igual a `usuarioId` quando foi auto-declaracao. E o que
  /// torna "quem me pos nesse carro?" uma pergunta respondivel.
  declaradoPorId String
  declaradoPor   Usuario               @relation("OcupacoesDeclaradas", fields: [declaradoPorId], references: [id], onDelete: Restrict)
  encerradoPor   EncerramentoOcupacao?

  /// A jornada que abriu esta ocupacao. Nulo em ajuste manual.
  jornadaId String?
  jornada   JornadaTecnico? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)

  /// OS pra qual esta ocupacao foi aberta ESPECIFICAMENTE. NULO E O NORMAL —
  /// uma ocupacao de turno atende varias OS.
  ///
  /// Nao e a resposta primaria de "que carro fez a OS X": aquela e DERIVADA do
  /// cruzamento da janela de execucao da OS com as ocupacoes do tecnico dela.
  /// Este campo so vence quando alguem afirmou.
  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  odometroInicio Int?
  odometroFim    Int?
  latInicio      Float?
  lngInicio      Float?
  latFim         Float?
  lngFim         Float?
  observacao     String?  @db.VarChar(200)
  criadoEm       DateTime @default(now())

  viagens Viagem[]

  @@index([veiculoId, inicioEm])
  @@index([usuarioId, inicioEm])
  @@index([jornadaId])
  @@index([ordemServicoId])
  @@map("ocupacoes_veiculo")
}

enum RastreadorFornecedor {
  plataformatk
}

/// TRES estados, e nao um booleano.
///
/// O fornecedor tem `ACC: ANOMALY` — "Ignição com Problemas". Traduzir isso pra
/// `false` afirmaria que o motor esta desligado, que e diferente de "o sensor
/// de ignicao esta com defeito". Como a VIAGEM nasce da ignicao, tratar
/// anomalia como desligado fecharia viagem sozinho por defeito de sensor.
///
/// Ausencia da coluna (NULL) continua sendo o quarto caso: o aparelho nao
/// contou. Ver `Ignicao` em @isphub/shared.
enum EstadoIgnicao {
  ligada
  desligada
  anomalia
}

/// Os tipos de EventoRastreador. Espelha `EVENTOS_RASTREADOR` de @isphub/shared
/// — a lista fechada e la; aqui e a trava do banco.
enum EventoRastreadorTipo {
  ignicao_ligada
  ignicao_desligada
  ignicao_anomalia
  bloqueio_ativado
  bloqueio_removido
  bateria_baixa
  bateria_normalizada
  ficou_offline
  voltou_online
  excesso_velocidade
  parado_com_motor_ligado
}

/// O rastreador e uma COISA, nao uma coluna do veiculo.
///
/// (a) o aparelho sobrevive ao carro — vendeu o carro, o rastreador vai pro
///     proximo; (b) comunicando/rastreando sao saude do APARELHO, nao do carro;
/// (c) a serie de posicoes precisa sobreviver a troca de associacao.
///
/// A origem guardava `fleet_vehicles.ptk_tracker_id` — uma coluna que APAGA
/// toda associacao anterior no instante em que muda.
model Rastreador {
  id String @id @default(uuid())

  /// Mesma regra hibrida do Veiculo: nulo = conta da propria operacao ISPhub.
  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: SetNull)

  fornecedor RastreadorFornecedor @default(plataformatk)

  /// O id do rastreador NO FORNECEDOR (ex.: "496538"). String, e nao Int: e
  /// identificador externo, e fazer aritmetica com ele nunca faz sentido.
  identificadorExterno String  @db.VarChar(60)
  apelido              String? @db.VarChar(60)
  ativo                Boolean @default(true)

  /// Caches de leitura, recomputaveis a partir de PosicaoRastreador.
  /// Tri-estado: nulo = a consulta falhou, nao sabemos. Nao afirme.
  ultimaPosicaoEm     DateTime?
  /// Quando o APARELHO falou com o servidor do fornecedor pela ultima vez
  /// (`lastCommunication` do `last-location`) — outro relogio, e nao um
  /// sinonimo de `ultimaPosicaoEm`.
  ///
  /// A distancia entre os dois e um diagnostico que nenhum outro campo da. Um
  /// rastreador em garagem, sob laje ou com a antena arrancada CONTINUA
  /// comunicando: o sensor COMMUNICATION segue `UP`, nenhum `ficou_offline`
  /// dispara, e o aparelho repete a ultima coordenada que conseguiu. O mapa
  /// entao mostra o carro parado num lugar onde ele nao esta mais — e a
  /// auditoria da frota, que mede cobertura pelos eventos de offline, nao ve
  /// buraco nenhum. Com os dois relogios, "esta calado" e "esta falando mas
  /// cego" deixam de ser a mesma coisa.
  ultimaComunicacaoEm DateTime?
  ultimoStatusEm      DateTime?
  comunicando         Boolean?
  rastreando          Boolean?

  /// ESTADO CORRENTE — tambem cache, recomputavel da ultima posicao. Existe pra
  /// a lista e o filtro ("quem esta com bateria baixa") nao precisarem varrer a
  /// serie de posicoes de cada aparelho.
  ignicao    EstadoIgnicao?
  bateriaPct Int?
  bloqueado  Boolean?
  /// Mapa CRU de todos os sensores. Ver o comentario em PosicaoRastreador.
  sensores   Json?

  /// Espelho do cadastro do fornecedor (`GET /trackers`), atualizado na coleta.
  ///
  /// NAO guarda `password`, IMEI nem numero do chip. A API devolve os tres — a
  /// senha SMS em texto puro — e nao temos uso para eles; guardar so criaria
  /// risco. O que fica e o que a tela precisa dizer sobre o aparelho.
  modeloFornecedor       String?   @db.VarChar(60)
  nomeFornecedor         String?   @db.VarChar(120)
  intervaloFornecedorSeg Int?
  temComandoCorte        Boolean   @default(false)
  instaladoEm            DateTime?

  criadoEm DateTime @default(now())

  posicoes PosicaoRastreador[]
  vinculos VinculoRastreador[]
  eventos  EventoRastreador[]
  viagens  Viagem[]

  @@unique([fornecedor, identificadorExterno])
  @@index([provedorId, ativo])
  @@map("rastreadores")
}

/// Associacao veiculo<->rastreador POR PERIODO.
///
/// Trocar o rastreador de carro nao pode apagar de onde o carro esteve com o
/// anterior. `onDelete: Restrict` nos dois lados de proposito: apagar um
/// veiculo nao pode apagar por onde ele andou. Veiculo se aposenta com
/// `status = inativo`, nunca com DELETE.
model VinculoRastreador {
  id           String     @id @default(uuid())
  veiculoId    String
  veiculo      Veiculo    @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  rastreadorId String
  rastreador   Rastreador @relation(fields: [rastreadorId], references: [id], onDelete: Restrict)

  inicioEm DateTime  @default(now())
  /// Nulo = vinculo VIGENTE. Os dois indices parciais observam isto.
  fimEm    DateTime?

  criadoPorId String?
  criadoPor   Usuario? @relation("VinculosRastreador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  observacao  String?  @db.VarChar(200)

  @@index([veiculoId, inicioEm])
  @@index([rastreadorId, inicioEm])
  @@map("vinculos_rastreador")
}

/// Serie de posicoes.
///
/// Pendura no RASTREADOR, nao no veiculo: o ponto e um fato do APARELHO, e a
/// associacao com o carro muda ao longo do tempo. Gravar `veiculoId` aqui
/// congelaria uma associacao que ainda vai mudar; a atribuicao acontece na
/// LEITURA, cruzando `registradoEm` com o vinculo vigente naquele instante.
model PosicaoRastreador {
  id           String     @id @default(uuid())
  rastreadorId String
  rastreador   Rastreador @relation(fields: [rastreadorId], references: [id], onDelete: Cascade)

  /// O carimbo DO RASTREADOR (`time` da PTK) — e a verdade, e a chave natural.
  registradoEm  DateTime
  lat           Float
  lng           Float
  velocidadeKmh Float?

  /// Tri-estado: nulo = a consulta de status falhou, nao sabemos.
  /// Mesma disciplina de `ResultadoStatusOs`: "ausente" e "indeterminado" nao
  /// podem ser o mesmo valor.
  movendo     Boolean?
  comunicando Boolean?
  rastreando  Boolean?

  /// Os TRES que viram coluna, e o porque de cada um:
  ///   `ignicao`    — e o que abre e fecha VIAGEM;
  ///   `bateriaPct` — e o que dispara ALERTA;
  ///   `bloqueado`  — e o estado que o gestor FILTRA.
  /// Consultar qualquer um deles dentro do Json seria lento e ilegivel.
  ignicao    EstadoIgnicao?
  bateriaPct Int?
  bloqueado  Boolean?

  /// TODOS os sensores, crus, como o fornecedor mandou.
  ///
  /// Esta coluna e a decisao central do modulo: **sensor nao vira coluna**. O
  /// fornecedor publica 14 hoje (`GET /status-descriptions`) e pode publicar o
  /// 15o amanha. Escolher quais viram coluna seria eu apostando em quais
  /// importam — e a aposta erra no dia em que chega um aparelho com sensor de
  /// porta, temperatura ou carga.
  ///
  /// O que nao tem coluna aqui em cima fica guardado aqui e aparece na tela
  /// pelo DICIONARIO do fornecedor, sem migracao nenhuma.
  sensores Json?

  /// Quando NOS buscamos. Nunca entra em chave nenhuma — cada replica tem o
  /// seu, e usa-lo na unicidade dobraria a tabela a cada replica.
  coletadoEm DateTime @default(now())

  @@unique([rastreadorId, registradoEm])
  @@map("posicoes_rastreador")
}

/// MUDANCA DE ESTADO — o que a linha do tempo conta e o sino avisa.
///
/// Serie de posicao responde "onde o carro estava"; evento responde "o que
/// mudou". Sao perguntas diferentes, e derivar a segunda da primeira toda vez
/// que alguem abre a tela custaria varrer 1.200 linhas por veiculo por dia.
model EventoRastreador {
  id           String     @id @default(uuid())
  rastreadorId String
  rastreador   Rastreador @relation(fields: [rastreadorId], references: [id], onDelete: Cascade)

  /// Qual VEICULO estava com o aparelho quando o evento aconteceu.
  ///
  /// Aqui a associacao e CONGELADA — ao contrario da posicao, que resolve o
  /// veiculo na leitura pelo vinculo vigente. A diferenca e proposital: "o
  /// carro estava a 118 km/h" e um fato historico daquele carro, e trocar o
  /// aparelho de veiculo amanha nao pode reescrever de quem foi a infracao.
  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  tipo EventoRastreadorTipo
  /// O carimbo DO APARELHO, como em PosicaoRastreador — e o que torna a chave
  /// natural estavel entre replicas.
  em   DateTime

  lat     Float?
  lng     Float?
  detalhe Json?

  /// Trava do sino, no padrao de `slaNotificadoEm`: nulo = ainda nao avisado.
  /// O job retenta no tique seguinte o que falhou.
  notificadoEm DateTime?

  criadoEm DateTime @default(now())

  /// Duas replicas rodando a mesma coleta produzem o MESMO evento a partir do
  /// mesmo par de leituras. A chave natural faz a segunda virar no-op em vez de
  /// duplicar o alerta.
  @@unique([rastreadorId, tipo, em])
  @@index([veiculoId, em])
  @@index([notificadoEm])
  @@map("eventos_rastreador")
}

/// VIAGEM — de ignicao ligada a ignicao desligada.
///
/// E o que responde "quantas saidas o carro fez hoje e quanto rodou". Antes
/// disso a unica resposta possivel era inferir parada por velocidade, que nao
/// distingue "chegou no cliente" de "parou no semaforo".
model Viagem {
  id           String     @id @default(uuid())
  veiculoId    String
  veiculo      Veiculo    @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  rastreadorId String
  rastreador   Rastreador @relation(fields: [rastreadorId], references: [id], onDelete: Cascade)

  /// Quem estava a bordo, quando havia ocupacao declarada. Opcional de
  /// proposito: o carro pode rodar sem ninguem ter declarado nada, e a viagem
  /// existiu do mesmo jeito.
  ocupacaoId String?
  ocupacao   OcupacaoVeiculo? @relation(fields: [ocupacaoId], references: [id], onDelete: SetNull)

  inicioEm DateTime
  /// Nulo = viagem EM CURSO. O indice parcial observa isto.
  fimEm    DateTime?

  latInicio Float
  lngInicio Float
  /// Enquanto a viagem esta ABERTA, "fim" quer dizer "ate agora": estes dois
  /// acompanham o ultimo ponto visto, e sao o que permite somar a distancia do
  /// proximo sem carregar a serie do dia.
  latFim    Float
  lngFim    Float

  /// O carimbo e a velocidade do ULTIMO ponto — o resto do acumulador.
  ///
  /// A coleta recebe um ponto por minuto e nao tem o dia na mao: sem estes, nao
  /// da pra calcular nem o intervalo (tempo parado) nem a distancia incremental.
  /// Anulaveis so por serem aditivos; a coleta sempre os preenche.
  ultimoEm            DateTime?
  ultimaVelocidadeKmh Float?

  distanciaMetros         Int?
  velocidadeMaxKmh        Float?
  /// Motor ligado com o carro imovel. Combustivel queimado a toa — e o insumo
  /// do alerta "parado com o motor ligado".
  paradoComMotorLigadoSeg Int?

  atualizadoEm DateTime @updatedAt

  @@index([veiculoId, inicioEm])
  @@index([rastreadorId, inicioEm])
  @@map("viagens")
}

/// Credencial do fornecedor de rastreamento, cifrada (AES-256-GCM, lib/crypto).
///
/// Modelo SEPARADO de ErpConfig, e nao um valor novo em ErpTipo. Nao e
/// preferencia: `jobs/syncScheduler.ts` faz
/// `erpConfig.findMany({ where: { ativo: true } })` SEM filtrar `tipo` e chama
/// `syncProvedor()` — uma linha PLATAFORMATK ali faria o sync do SGP disparar
/// no intervalo do rastreador. E `buildConnector` devolve `ErpConnector`, uma
/// interface de ~15 metodos que a PTK nao implementa.
model RastreadorConfig {
  id         String    @id @default(uuid())
  /// Nulo = a conta da propria operacao ISPhub.
  provedorId String?
  provedor   Provedor? @relation(fields: [provedorId], references: [id], onDelete: Cascade)

  fornecedor   RastreadorFornecedor @default(plataformatk)
  baseUrl      String               @default("https://api.plataformatk.com.br")
  /// "<iv_b64>:<tag_b64>:<ct_b64>". Nunca sai em claro por rota nenhuma.
  chaveCifrada String

  intervaloPollingSegundos Int     @default(60)
  ativo                    Boolean @default(true)

  /// Check-in automatico: viatura parada a ate N metros do endereco da OS "a
  /// caminho" vira "em execucao". 0 desliga.
  checkinRaioMetros Int @default(150)

  /// Limite unico da frota, em km/h. Configuravel porque 100 e o limite de uma
  /// rodovia e o absurdo de uma rua residencial — e quem sabe qual serve e o
  /// gestor, nao eu.
  limiteVelocidadeKmh Int @default(100)

  /// Cache de `GET /status-descriptions` — o dicionario que da rotulo e
  /// severidade a cada sensor.
  ///
  /// No BANCO e nao em memoria: se o fornecedor estiver fora no boot, a tela
  /// ainda sabe dizer que `ACC` e "IGNIÇÃO" e que 12% e `danger`. Um cache em
  /// memoria transformaria uma indisponibilidade deles numa tela ilegivel
  /// nossa.
  dicionarioSensores Json?
  dicionarioEm       DateTime?

  ultimaColetaEm       DateTime?
  ultimaColetaOk       Boolean?
  ultimaColetaMensagem String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("rastreador_configs")
}

/// Credencial da Brazmovel — a telefonia movel corporativa da CITmax.
///
/// **Uma so para a operacao inteira**, sem `provedorId`. O `RastreadorConfig`
/// acima tem a coluna e ela nunca foi exercitada (a unica rota que grava passa
/// sempre `provedorId: null`); aqui a dimensao nem existe de verdade: os
/// tecnicos sao funcionarios da propria operacao, e o contrato com a operadora e
/// da CITmax. Copiar a generalidade seria replicar codigo morto.
///
/// O token e do PARCEIRO e vale para a base INTEIRA da operadora — por isso ele
/// nunca sai por rota nenhuma, nem mascarado, e quem decide o que cada usuario
/// pode ver e a rota, nunca o conector.
model BrazmovelConfig {
  id String @id @default(uuid())

  baseUrl      String  @default("https://api.brazmovel.com.br/v1")
  /// "<iv_b64>:<tag_b64>:<ct_b64>" (AES-256-GCM, ver lib/crypto.ts).
  tokenCifrado String
  ativo        Boolean @default(true)

  ultimoTesteEm       DateTime?
  ultimoTesteOk       Boolean?
  /// Guarda o status HTTP observado junto da mensagem: daqui a seis meses, a
  /// diferenca entre "401" e "timeout" e a diferenca entre 5 minutos e 2 horas
  /// de investigacao.
  ultimoTesteMensagem String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("brazmovel_configs")
}

/// A grade da agenda. UMA linha so (`id = "global"`).
///
/// A capacidade e da EQUIPE, nao do contrato: sao os mesmos tecnicos atendendo
/// todos os provedores, entao um teto por provedor deixaria a soma passar do
/// que a rua aguenta. Se um dia as equipes forem regionais, o recorte natural e
/// por cidade/POP, nao por provedor.
model AgendaConfig {
  id String @id @default("global")

  vagasManha Int @default(20)
  vagasTarde Int @default(20)

  /// Teto do DIA inteiro, alem do teto de cada turno. Nulo = sem teto proprio.
  ///
  /// Os dois numeros respondem perguntas diferentes: o do turno e quantas
  /// visitas cabem numa saida, o do dia e quantas a equipe aguenta antes de a
  /// ultima virar madrugada. Com 20+20 e teto diario de 30, as 10 ultimas nao
  /// sao oferecidas em turno nenhum.
  vagasDia Int?

  /// Teto de visitas por REGIAO dentro de um turno. Nulo = sem teto regional.
  ///
  /// E o que a planilha queria dizer com "concentracao" e nunca fez: ela tinha
  /// a coluna Bairro e contava so o total do dia, entao 40 OS espalhadas por
  /// bairros opostos passavam batido.
  tetoRegiao Int?

  /// Dias da semana atendidos, 0=domingo … 6=sabado. Padrao seg-sab.
  /// A planilha ofertava domingo com capacidade cheia.
  diasAtendidos Int[] @default([1, 2, 3, 4, 5, 6])

  /// Quantos dias a frente a grade vai. A planilha mostrava 14.
  horizonteDias Int @default(14)

  /// Antecedencia minima, em minutos, entre agora e o inicio do turno ofertado
  /// — pra nao oferecer a manha de hoje as 11h.
  antecedenciaMin Int @default(120)

  /// Quantas vezes o PROPRIO CLIENTE pode remarcar sozinho, pelo WhatsApp.
  /// Passou disso, a conversa vai pra um humano: remarcacao sem teto vira
  /// ping-pong as custas da rota de quem ja saiu pra rua.
  remarcacoesMaxCliente Int @default(2)

  /// De onde a equipe sai — origem da rota sugerida. Nulo = usa a 1a parada.
  baseLat Float?
  baseLng Float?

  /// Visitas que UM tecnico faz por turno. Preenchido, a capacidade do turno
  /// vira min(vagas fixas, escalados x isto); nulo = so as vagas fixas valem.
  vagasPorTecnico Int?

  atualizadoEm DateTime @updatedAt

  @@map("agenda_config")
}

/// Manutencao preventiva por km e/ou por dias: "troca de oleo a cada 10.000 km".
/// `ultimaKm`/`ultimaEm` = quando foi feita pela ultima vez; o vencimento e
/// derivado do odometro atual do veiculo (ver `estadoManutencao`).
model PlanoManutencao {
  id        String  @id @default(uuid())
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  tipo          String @db.VarChar(40)
  intervaloKm   Int?
  intervaloDias Int?
  ultimaKm      Int?
  ultimaEm      DateTime?

  ativo Boolean @default(true)
  /// Trava do sino: nulo = ainda nao avisado; zera ao concluir.
  avisadoEm DateTime?

  criadoEm DateTime @default(now())

  @@index([veiculoId, ativo])
  @@map("planos_manutencao")
}

/// Foto do painel, km, combustivel e avarias na saida e no retorno da viatura.
/// Preso a ocupacao: e "este tecnico, neste carro, neste turno".
model ChecklistViatura {
  id         String  @id @default(uuid())
  ocupacaoId String
  veiculoId  String
  veiculo    Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  usuarioId  String

  /// saida | retorno
  momento        String @db.VarChar(10)
  odometroKm     Int?
  combustivelPct Int?
  avarias        String? @db.VarChar(400)
  fotoPainel     Bytes?
  fotoMime       String? @db.VarChar(40)
  lat            Float?
  lng            Float?
  criadoEm       DateTime @default(now())

  @@index([veiculoId, criadoEm])
  @@index([ocupacaoId])
  @@map("checklists_viatura")
}

/// A viatura esteve no endereco da OS concluida? Derivado e recalculavel.
/// `sem_dados` nunca alerta: sem posicao, sem endereco ou sem veiculo nao ha
/// como afirmar nada.
model AuditoriaVisita {
  id             String       @id @default(uuid())
  ordemServicoId String       @unique
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  veiculoId      String?

  /// presente | ausente | sem_dados
  veredito           String
  distanciaMinMetros Int?
  posicoes           Int
  inicioEm           DateTime
  fimEm              DateTime
  auditadaEm         DateTime @default(now())
  /// Quando o aviso "visita sem presenca" saiu pros gestores.
  notificadaEm DateTime?

  @@index([veredito, auditadaEm])
  @@map("auditorias_visita")
}

/// Quanto a viatura rodou ATE uma OS: do fim da parada anterior (ou inicio da
/// jornada) ao inicio desta. Derivado e recalculavel — por isso tabela propria,
/// e nao coluna no espelho da OS.
model DeslocamentoOs {
  id             String       @id @default(uuid())
  ordemServicoId String       @unique
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  veiculoId String?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  inicioEm DateTime
  fimEm    DateTime
  metros   Int
  pontos   Int
  /// gps = soma dos trechos; estimado = reta x fator de rua; sem_dados = nao deu pra medir.
  fonte String

  calculadoEm DateTime @default(now())

  @@index([veiculoId, inicioEm])
  @@map("deslocamentos_os")
}

/// Uma OS marcada num dia + turno. E a FONTE DA VERDADE da agenda.
///
/// Por que nao usar `OrdemServico.dataAgendamento`: aquele campo e espelho puro
/// do SGP e o sync o sobrescreve a cada ciclo, sem janela de protecao (ver
/// syncService). Uma agenda morando la seria apagada sozinha algumas vezes por
/// hora.
///
/// Por que a chave e `sgpOsId` e nao `ordemServicoId`: quem marca pode ser o
/// atendimento, que abre a OS no SGP e recebe o id na hora — mas o espelho do
/// ISPhub so a enxerga no ciclo seguinte, ate ~3 min depois. Chavear pela OS
/// local tornaria impossivel marcar no momento da conversa, que e exatamente o
/// momento em que o cliente esta na linha. `(provedorId, sgpOsId)` e a mesma
/// chave que o sync ja usa, entao a ligacao acontece sozinha quando ela chega.
model Agendamento {
  id         String   @id @default(uuid())
  provedorId String
  provedor   Provedor @relation(fields: [provedorId], references: [id], onDelete: Cascade)

  sgpOsId String

  /// Preenchido quando o sync espelhar a OS. Nulo = marcada e ainda nao vista.
  ordemServicoId String?       @unique
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  /// DATE puro: a agenda e do DIA. Guardar instante faria "23h em Natal" cair
  /// no dia seguinte — o mesmo motivo de `EscalaJornada.dia`.
  dia   DateTime    @db.Date
  turno TurnoAgenda

  /// POP (ou bairro) no momento da marcacao — o teto regional conta por aqui.
  ///
  /// Copiado em vez de lido da OS de proposito: no instante da marcacao a OS
  /// pode nem existir no espelho, e `bairro` so aparece depois do backfill de
  /// cadastro (30 contratos por ciclo, TTL de 7 dias). `pop` vem sempre.
  regiao String?

  status StatusAgendamento @default(marcado)

  /// A ordem da visita no dia, definida pelo supervisor. E a coluna "Ordem da
  /// Rota" da planilha — que la morria na planilha; aqui ela chega no app do
  /// tecnico.
  ordemRota Int?

  origem String

  /// Quem marcou (nome da atendente, login, ou "IA"). Colunas "Atendente" e
  /// "Data do Registro" da planilha viram dado auditavel.
  marcadoPor String?

  observacao String?

  /// Quando o CLIENTE confirmou a visita, respondendo o lembrete da vespera.
  /// Nulo = ainda nao respondeu (nao e o mesmo que "nao vem").
  confirmadoEm DateTime?

  /// Quantas vezes o proprio cliente remarcou. Conta so o que veio DELE — a
  /// atendente e o bot remarcando em nome dele nao gastam o teto.
  remarcacoesCliente Int @default(0)

  /// Quando o SGP CONFIRMOU a data na leitura seguinte — nao quando mandamos.
  /// `/api/os/update/` ja devolveu 200 ignorando campo que nao aceita, entao
  /// "escrevi" nao e evidencia de "gravou".
  sgpConfirmadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([provedorId, sgpOsId])
  @@index([dia, turno, status])
  @@index([dia, regiao, status])
  @@map("agendamentos")
}

/// Um dia que foge da regra do calendario.
///
/// Duas coisas na mesma tabela de proposito, porque sao a mesma pergunta com
/// sinal trocado: o feriado municipal que FECHA um dia util, e o sabado de
/// mutirao que ABRE um dia que nao seria atendido. Duas tabelas separadas
/// teriam que ser consultadas juntas de qualquer jeito, e poderiam discordar
/// sobre o mesmo dia.
///
/// Vale pra agenda inteira: a equipe e uma so, e a referencia acordada e o
/// calendario de Macaiba/RN, onde fica a sede. Feriado nacional NAO entra aqui
/// — aquele e calculado (ver shared/feriados.ts), justamente pra ninguem
/// precisar lembrar de cadastrar dezembro.
model ExcecaoAgenda {
  id String @id @default(uuid())

  /// DATE puro, e UNICO: cadastrar o mesmo dia de novo ATUALIZA a regra, em
  /// vez de empilhar uma segunda que discordaria da primeira.
  dia DateTime @unique @db.Date

  /// false = nao atende (o caso comum). true = atende MESMO assim, e ganha de
  /// domingo e de feriado nacional — e o override humano, entao vence tudo.
  atende Boolean @default(false)

  /// Aparece na grade do supervisor. Um dia que some sem explicacao vira
  /// chamado interno perguntando por que.
  motivo String

  definidoPor  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("excecoes_agenda")
}
